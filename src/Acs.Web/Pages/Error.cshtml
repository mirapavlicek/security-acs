@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
}
<h1>@Model.Title</h1>
<div class="card" style="max-width:640px">
    <p>@Model.Explanation</p>
    <p class="muted">
        Stav @Model.StatusCode
        @if (Model.OriginalPath is not null)
        {
            <text>· <span class="mono">@Model.OriginalPath</span></text>
        }
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <text>· identifikátor požadavku <span class="mono">@Model.RequestId</span></text>
        }
    </p>
    <div class="btn-row">
        <a class="btn" href="javascript:history.back()">Zpět</a>
        <a class="btn btn-ghost" asp-page="/Index">Domů</a>
    </div>
</div>

@page
@model Acs.Web.Pages.Account.WindowsLoginModel
@{
    ViewData["Title"] = "Přihlášení účtem Windows";
}
<div class="login-box card">
    <div class="brand" style="margin-bottom:1rem">
        <span class="brand-mark">ACS</span>
        <span class="brand-sub">schvalování přístupů k místnostem</span>
    </div>

    <h2 style="margin-top:0">Přihlášení účtem Windows</h2>
    <p class="muted">
        Prohlížeč byl vyzván, aby se prokázal účtem, kterým jste přihlášeni k počítači v doméně
        (Kerberos / NTLM). Pokud vidíte tuto stránku, prohlížeč výzvu nezvládl — počítač není
        v doméně, přihlašovací dialog byl zrušen nebo adresa aplikace není v zóně „Místní intranet“.
    </p>
    <a class="btn" style="width:100%" asp-page="/Account/Login" asp-route-manual="1" asp-route-returnUrl="@Model.ReturnUrl">
        Přihlásit jménem a heslem
    </a>
    <p class="muted" style="margin-top:.75rem">
        <a asp-page="/Account/WindowsLogin" asp-route-returnUrl="@Model.ReturnUrl">Zkusit přihlášení Windows znovu</a>
    </p>
</div>

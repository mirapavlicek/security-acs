@page
@model Acs.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}
<div class="login-box card">
    <div class="brand" style="margin-bottom:1rem">
        <span class="brand-mark">ACS</span>
        <span class="brand-sub">schvalování přístupů k místnostem</span>
    </div>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }
    @if (Model.InfoMessage is not null)
    {
        <div class="alert alert-success">@Model.InfoMessage</div>
    }

    @if (Model.WindowsLoginEnabled)
    {
        <a class="btn login-windows" asp-page="/Account/WindowsLogin" asp-route-returnUrl="@Model.ReturnUrl">
            Přihlásit účtem Windows
        </a>
        <p class="muted login-windows-hint">Použije účet, kterým jste přihlášeni k počítači v doméně (Kerberos / NTLM).</p>
        <div class="login-divider"><span>nebo jménem a heslem</span></div>
    }

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <label asp-for="UserName">Uživatelské jméno (AD účet nebo lokální)</label>
        <input asp-for="UserName" type="text" autofocus="@(!Model.WindowsLoginEnabled)" autocomplete="username"
               placeholder="jnovak" />
        <p class="hint" style="margin-top:-0.4rem">U AD účtu stačí přihlašovací jméno — <code>@@@Model.LdapDomain</code> se doplní automaticky.</p>

        <label asp-for="Password">Heslo</label>
        <input asp-for="Password" type="password" autocomplete="current-password" />

        <button type="submit" class="btn" style="width:100%">Přihlásit se</button>
    </form>
</div>

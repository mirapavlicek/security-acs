@page
@model Acs.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Změna hesla";
}
<div class="login-box card">
    <h1>Změna hesla</h1>

    @if (Model.MustChange)
    {
        <div class="alert alert-error">Před pokračováním je nutné změnit výchozí heslo.</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <label asp-for="CurrentPassword">Současné heslo</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />

        <label asp-for="NewPassword">Nové heslo (min. 12 znaků)</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />

        <label asp-for="ConfirmPassword">Nové heslo znovu</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />

        <button type="submit" class="btn" style="width:100%">Změnit heslo</button>
    </form>
</div>

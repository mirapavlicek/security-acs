@page
@model Acs.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Přehled";
    var a = Model.Attention;
}
<h1>Přehled</h1>

@if (a.PendingApprovals > 0 || (Model.IsCardAdmin && a.CardQueue > 0) || (Model.IsParkingAdmin && a.ParkingQueue > 0))
{
    <section class="dash-section">
        <h2>Čeká na vás</h2>
        <div class="tile-grid">
            @if (a.PendingApprovals > 0)
            {
                <a class="tile tile-attention" asp-page="/Requests/Index">
                    <span class="tile-count">@a.PendingApprovals</span>
                    <span class="tile-title">Ke schválení</span>
                    <span class="tile-desc">položek čeká na vaše rozhodnutí (včetně zástupů)</span>
                </a>
            }
            @if (Model.IsCardAdmin && a.CardQueue > 0)
            {
                <a class="tile tile-attention" asp-page="/CardQueue">
                    <span class="tile-count">@a.CardQueue</span>
                    <span class="tile-title">Fronta karet</span>
                    <span class="tile-desc">schválených přístupů k zadání do WIN-PAK</span>
                </a>
            }
            @if (Model.IsParkingAdmin && a.ParkingQueue > 0)
            {
                <a class="tile tile-attention" asp-page="/Parking/Queue">
                    <span class="tile-count">@a.ParkingQueue</span>
                    <span class="tile-title">Fronta parkování</span>
                    <span class="tile-desc">parkovacích povolení k vydání nebo odebrání</span>
                </a>
            }
        </div>
    </section>
}

<section class="dash-section">
    <h2>Moje</h2>
    <div class="tile-grid">
        <a class="tile" asp-page="/MyAccess">
            @if (Model.HasEmployee)
            {
                <span class="tile-count">@Model.MyActiveAccesses</span>
            }
            <span class="tile-title">Moje přístupy</span>
            <span class="tile-desc">přidělené přístupy, stav žádostí, žádost o odebrání</span>
        </a>
        <a class="tile" asp-page="/Requests/New">
            <span class="tile-title">Nová žádost o přístup</span>
            <span class="tile-desc">čtečka nebo skupina, řetězec chodeb se doplní sám</span>
        </a>
        <a class="tile" asp-page="/Requests/Index">
            @if (a.MyPending > 0)
            {
                <span class="tile-count">@a.MyPending</span>
            }
            <span class="tile-title">Žádosti</span>
            <span class="tile-desc">@(a.MyPending > 0 ? "mých položek ještě není vyřízeno" : "moje žádosti a schvalování")</span>
        </a>
        <a class="tile" asp-page="/Parking/Index">
            @if (Model.HasEmployee)
            {
                <span class="tile-count">@Model.MyActivePermits</span>
            }
            <span class="tile-title">Parkování</span>
            <span class="tile-desc">parkovací povolení na SPZ nebo funkci, kartička za sklo</span>
        </a>
        <a class="tile" asp-page="/Plans">
            <span class="tile-title">Plány pater</span>
            <span class="tile-desc">kde jsou čtečky a kam mám přístup</span>
        </a>
        <a class="tile" asp-page="/Deputies">
            <span class="tile-title">Zástupy</span>
            <span class="tile-desc">kdo schvaluje za mě, když nejsem k dispozici</span>
        </a>
    </div>
</section>

@if (Model.IsCardAdmin || Model.IsParkingAdmin)
{
    <section class="dash-section">
        <h2>Fronty</h2>
        <div class="tile-grid">
            @if (Model.IsCardAdmin)
            {
                <a class="tile @(a.CardQueue > 0 ? "tile-attention" : "")" asp-page="/CardQueue">
                    <span class="tile-count">@a.CardQueue</span>
                    <span class="tile-title">Fronta správce karet</span>
                    <span class="tile-desc">@(a.CardQueue > 0 ? "položek čeká na zadání do WIN-PAK" : "fronta je prázdná")</span>
                </a>
            }
            @if (Model.IsParkingAdmin)
            {
                <a class="tile @(a.ParkingQueue > 0 ? "tile-attention" : "")" asp-page="/Parking/Queue">
                    <span class="tile-count">@a.ParkingQueue</span>
                    <span class="tile-title">Fronta správce parkování</span>
                    <span class="tile-desc">@(a.ParkingQueue > 0 ? "povolení k vydání nebo odebrání" : "fronta je prázdná")</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.IsCatalogManager)
{
    <section class="dash-section">
        <h2>Číselníky</h2>
        <div class="tile-grid tile-grid-compact">
            <a class="tile" asp-page="/Catalog/Readers/Index"><span class="tile-count">@Model.ReaderCount</span><span class="tile-title">Čtečky</span><span class="tile-desc">aktivních, sync z WIN-PAK</span></a>
            <a class="tile" asp-page="/Catalog/AccessLevels/Index"><span class="tile-title">Úrovně přístupu</span><span class="tile-desc">access levely WIN-PAK</span></a>
            <a class="tile" asp-page="/Catalog/Groups/Index"><span class="tile-count">@Model.GroupCount</span><span class="tile-title">Skupiny čteček</span><span class="tile-desc">i vnořené, vlastní matice</span></a>
            <a class="tile" asp-page="/Catalog/Places"><span class="tile-count">@Model.BuildingCount</span><span class="tile-title">Budovy</span><span class="tile-desc">části, patra, chodby, místnosti</span></a>
            <a class="tile" asp-page="/Catalog/Employees/Index"><span class="tile-count">@Model.EmployeeCount</span><span class="tile-title">Zaměstnanci</span><span class="tile-desc">z AD, karty a SPZ</span></a>
            <a class="tile" asp-page="/Catalog/Matrices/Index"><span class="tile-count">@Model.MatrixCount</span><span class="tile-title">Schvalovací matice</span><span class="tile-desc">úrovně a schvalovatelé</span></a>
            <a class="tile" asp-page="/Catalog/AutoRules"><span class="tile-title">Auto-zařazení</span><span class="tile-desc">oddělení → skupina čteček</span></a>
            <a class="tile" asp-page="/Catalog/Parking/Sites"><span class="tile-count">@Model.SiteCount</span><span class="tile-title">Areály</span><span class="tile-desc">Motol, Homolka…</span></a>
            <a class="tile" asp-page="/Catalog/Parking/PermitTypes"><span class="tile-count">@Model.PermitTypeCount</span><span class="tile-title">Druhy povolení</span><span class="tile-desc">vazba, matice, kartička</span></a>
            <a class="tile" asp-page="/Reports"><span class="tile-count">@Model.IssuedPermitCount</span><span class="tile-title">Reporty</span><span class="tile-desc">kdo má kam, vydaná povolení · PDF / CSV</span></a>
        </div>
    </section>
}

@if (Model.IsAdmin)
{
    <section class="dash-section">
        <h2>Systém</h2>
        <div class="tile-grid tile-grid-compact">
            <a class="tile" asp-page="/Admin/Users/Index"><span class="tile-count">@Model.UserCount</span><span class="tile-title">Uživatelé a role</span><span class="tile-desc">AD účty, lokální admin, role</span></a>
            <a class="tile" asp-page="/Admin/Automation"><span class="tile-title">Automatizace</span><span class="tile-desc">offboarding, expirace, připomínky</span></a>
            <a class="tile" asp-page="/Admin/Settings"><span class="tile-title">Nastavení</span><span class="tile-desc">AD, WIN-PAK, SMTP, zdroje dat</span></a>
            <a class="tile" asp-page="/Admin/ConnectorUpdate">
                <span class="tile-title">WIN-PAK konektor</span>
                <span class="tile-desc">stav: <strong>@Model.WinPakStatus</strong></span>
            </a>
            <a class="tile" asp-page="/Admin/Audit"><span class="tile-title">Audit</span><span class="tile-desc">kdo, co, kdy</span></a>
        </div>
    </section>
}

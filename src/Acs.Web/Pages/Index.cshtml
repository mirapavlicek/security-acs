@page
@model Acs.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Přehled";
}
<h1>Přehled</h1>

<div class="cards-grid">
    <div class="card">
        <h2 style="margin-top:0">Moje přístupy</h2>
        <p class="muted">Přehled přístupů, které máte přiděleny, a stav vašich žádostí.</p>
        <a class="btn" asp-page="/MyAccess">Otevřít</a>
    </div>
    <div class="card">
        <h2 style="margin-top:0">Nová žádost</h2>
        <p class="muted">Žádost o přístup ke čtečce včetně automatického doplnění řetězce (chodba, patro…).</p>
        <a class="btn" asp-page="/Requests/New">Podat žádost</a>
    </div>
    <div class="card">
        <h2 style="margin-top:0">
            Ke schválení
            @if (Model.Attention.PendingApprovals > 0)
            {
                <span class="nav-badge card-badge">@Model.Attention.PendingApprovals</span>
            }
        </h2>
        <p class="muted">
            @if (Model.Attention.PendingApprovals > 0)
            {
                <span class="attention-dot"></span>
                <strong>@Model.Attention.PendingApprovals</strong> @:položek čeká na vaše rozhodnutí (včetně zástupů).
            }
            else
            {
                @:Žádosti čekající na vaše rozhodnutí (včetně zástupů). Teď nic nečeká.
            }
        </p>
        <a class="btn" asp-page="/Requests/Index">Otevřít žádosti</a>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("CardAdmin"))
    {
        <div class="card">
            <h2 style="margin-top:0">
                Fronta správce karet
                @if (Model.Attention.CardQueue > 0)
                {
                    <span class="nav-badge card-badge">@Model.Attention.CardQueue</span>
                }
            </h2>
            <p class="muted">
                @if (Model.Attention.CardQueue > 0)
                {
                    <span class="attention-dot"></span>
                    <strong>@Model.Attention.CardQueue</strong> @:schválených položek čeká na zadání do WIN-PAK.
                }
                else
                {
                    @:Schválené žádosti k zadání do WIN-PAK (API / ruční potvrzení). Fronta je prázdná.
                }
            </p>
            <a class="btn" asp-page="/CardQueue">Otevřít frontu</a>
        </div>
    }
    @if (User.IsInRole("Admin"))
    {
        <div class="card">
            <h2 style="margin-top:0">Stav systému</h2>
            <table class="data">
                <tr><td>Uživatelů</td><td>@Model.UserCount</td></tr>
                <tr><td>Zaměstnanců</td><td>@Model.EmployeeCount</td></tr>
                <tr><td>Čteček</td><td>@Model.ReaderCount</td></tr>
                <tr><td>WIN-PAK konektor</td><td>@Model.WinPakStatus</td></tr>
            </table>
        </div>
    }
</div>

@inject Acs.Infrastructure.Notifications.AttentionService Attention
@{
    var theme = Context.Request.Cookies["acs-theme"] ?? "light";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool HasRole(string role) => User.IsInRole("Admin") || User.IsInRole(role);

    var attention = isAuthenticated
        ? await Attention.GetAsync(User, Context.RequestAborted)
        : new Acs.Infrastructure.Notifications.AttentionCounts(0, 0, 0);

    // Skupina v menu se zvýrazní, když jsme na některé z jejích stránek.
    var path = Context.Request.Path.Value ?? "";
    bool InSection(params string[] prefixes) => prefixes.Any(prefix => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="cs" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ACS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">
        <span class="brand-mark">ACS</span>
        <span class="brand-sub">schvalování přístupů</span>
    </a>

    @if (isAuthenticated)
    {
        <nav class="mainnav">
            <a asp-page="/Index">Přehled</a>
            <a asp-page="/Requests/Index">
                Žádosti
                @if (attention.PendingApprovals > 0)
                {
                    <span class="nav-badge" title="@attention.PendingApprovals položek čeká na vaše schválení">@attention.PendingApprovals</span>
                }
            </a>
            <a asp-page="/MyAccess">Moje přístupy</a>
            <a asp-page="/Parking/Index">
                Parkování
                @if (attention.ParkingQueue > 0)
                {
                    <span class="nav-badge" title="@attention.ParkingQueue parkovacích povolení čeká na vydání">@attention.ParkingQueue</span>
                }
            </a>
            <a asp-page="/Plans">Plány</a>
            @if (HasRole("CardAdmin"))
            {
                <a asp-page="/CardQueue">
                    Fronta karet
                    @if (attention.CardQueue > 0)
                    {
                        <span class="nav-badge" title="@attention.CardQueue položek čeká na zadání do WIN-PAK">@attention.CardQueue</span>
                    }
                </a>
            }
            @if (HasRole("CatalogManager"))
            {
                <details class="navgroup @(InSection("/Catalog", "/Reports") ? "navgroup-active" : "")">
                    <summary>Katalog</summary>
                    <div class="navgroup-panel">
                        <span class="navgroup-header">Přístupy</span>
                        <a asp-page="/Catalog/Readers/Index">Čtečky</a>
                        <a asp-page="/Catalog/AccessLevels/Index">Přístupové úrovně (WIN-PAK)</a>
                        <a asp-page="/Catalog/Groups/Index">Skupiny čteček</a>
                        <a asp-page="/Catalog/Matrices/Index">Schvalovací matice</a>
                        <a asp-page="/Catalog/AutoRules">Automatické zařazení</a>
                        <span class="navgroup-header">Lidé a místa</span>
                        <a asp-page="/Catalog/Employees/Index">Zaměstnanci</a>
                        <a asp-page="/Catalog/Places">Budovy a místnosti</a>
                        <span class="navgroup-header">Parkování</span>
                        <a asp-page="/Catalog/Parking/Sites">Areály</a>
                        <a asp-page="/Catalog/Parking/PermitTypes">Druhy povolení</a>
                        <span class="navgroup-header">Přehledy</span>
                        <a asp-page="/Reports">Reporty</a>
                    </div>
                </details>
            }
            @if (User.IsInRole("Admin"))
            {
                <details class="navgroup @(InSection("/Admin") ? "navgroup-active" : "")">
                    <summary>Správa</summary>
                    <div class="navgroup-panel">
                        <a asp-page="/Admin/Users/Index">Uživatelé a role</a>
                        <a asp-page="/Admin/Settings">Nastavení</a>
                        <a asp-page="/Admin/Automation">Automatizace a stav systému</a>
                        <a asp-page="/Admin/ConnectorUpdate">WIN-PAK konektor</a>
                        <a asp-page="/Admin/ImportReaders">Import čteček z EKV</a>
                        <a asp-page="/Admin/Audit">Audit</a>
                    </div>
                </details>
            }
        </nav>
    }

    <div class="topbar-right">
        <form method="post" action="/set-theme" class="theme-form">
            <select name="theme" onchange="this.form.submit()" aria-label="Barevné téma">
                @foreach (var (value, label) in new[]
                {
                    ("light", "Světlé"), ("dark", "Tmavé"), ("blue", "Modré"),
                    ("green", "Zelené"), ("purple", "Fialové"), ("contrast", "Kontrastní"),
                })
                {
                    <option value="@value" selected="@(theme == value)">@label</option>
                }
            </select>
        </form>

        @if (isAuthenticated)
        {
            <details class="usermenu">
                <summary class="user-badge" title="@User.Identity!.Name">
                    @(User.FindFirst("display_name")?.Value ?? User.Identity!.Name)
                </summary>
                <div class="usermenu-panel">
                    <span class="usermenu-header">@User.Identity!.Name</span>
                    <a asp-page="/Deputies">Zástupy</a>
                    @if (User.HasClaim("is_local", "1"))
                    {
                        <a asp-page="/Account/ChangePassword">Změna hesla</a>
                    }
                    <form method="post" asp-page="/Account/Login" asp-page-handler="Logout">
                        <button type="submit" class="btn btn-ghost">Odhlásit</button>
                    </form>
                </div>
            </details>
        }
    </div>
</header>

<main class="content">
    @RenderBody()
</main>

<footer class="footer">
    <span>ACS · acs.fnmh.network</span>
</footer>
<script>
// Rozbalovací nabídky (skupiny v menu, menu uživatele): otevřená je vždy jen jedna,
// zavře se kliknutím jinam nebo klávesou Esc.
(() => {
    const menus = [...document.querySelectorAll('details.usermenu, details.navgroup')];
    if (menus.length === 0) return;
    for (const menu of menus)
        menu.addEventListener('toggle', () => { if (menu.open) for (const other of menus) if (other !== menu) other.open = false; });
    document.addEventListener('click', e => { for (const menu of menus) if (!menu.contains(e.target)) menu.open = false; });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') for (const menu of menus) menu.open = false; });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

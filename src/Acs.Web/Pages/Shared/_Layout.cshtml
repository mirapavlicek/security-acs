@inject Acs.Infrastructure.Notifications.AttentionService Attention
@{
    var theme = Context.Request.Cookies["acs-theme"] ?? "light";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool HasRole(string role) => User.IsInRole("Admin") || User.IsInRole(role);

    var attention = isAuthenticated
        ? await Attention.GetAsync(User, Context.RequestAborted)
        : new Acs.Infrastructure.Notifications.AttentionCounts(0, 0, 0);

    // Zvýraznění aktuální položky v navigaci podle cesty Razor Page (např. "/Requests/Detail").
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) => prefix == "/Index"
        ? (currentPage == "/Index" ? "active" : "")
        : (currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "");
    var inCatalog = currentPage.StartsWith("/Catalog/", StringComparison.OrdinalIgnoreCase) || currentPage == "/Reports";
    var inAdmin = currentPage.StartsWith("/Admin/", StringComparison.OrdinalIgnoreCase)
                  || currentPage == "/CardQueue" || currentPage == "/Parking/Queue";
}
<!DOCTYPE html>
<html lang="cs" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ACS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">
        <span class="brand-mark">ACS</span>
        <span class="brand-sub">schvalování přístupů</span>
    </a>

    @if (isAuthenticated)
    {
        @* Hlavní navigace: pět nejčastějších cílů přímo, číselníky a správa ve dvou rozbalovacích skupinách. *@
        <nav class="mainnav" aria-label="Hlavní navigace">
            <a asp-page="/Index" class="@Active("/Index")">Přehled</a>
            <a asp-page="/Requests/Index" class="@Active("/Requests/")">
                Žádosti
                @if (attention.PendingApprovals > 0)
                {
                    <span class="nav-badge" title="@attention.PendingApprovals položek čeká na vaše schválení">@attention.PendingApprovals</span>
                }
            </a>
            <a asp-page="/MyAccess" class="@Active("/MyAccess")">Moje přístupy</a>
            <a asp-page="/Parking/Index" class="@Active("/Parking/")">Parkování</a>
            <a asp-page="/Plans" class="@Active("/Plans")">Plány</a>

            @if (HasRole("CatalogManager"))
            {
                <details class="navmenu @(inCatalog ? "active" : "")">
                    <summary>Číselníky</summary>
                    <div class="navmenu-panel">
                        <span class="navmenu-group">Přístupy</span>
                        <a asp-page="/Catalog/Readers/Index">Čtečky</a>
                        <a asp-page="/Catalog/AccessLevels/Index">Úrovně přístupu</a>
                        <a asp-page="/Catalog/Groups/Index">Skupiny čteček</a>
                        <a asp-page="/Catalog/Places">Budovy a místnosti</a>
                        <span class="navmenu-group">Parkování</span>
                        <a asp-page="/Catalog/Parking/Sites">Areály</a>
                        <a asp-page="/Catalog/Parking/PermitTypes">Druhy povolení</a>
                        <span class="navmenu-group">Lidé a schvalování</span>
                        <a asp-page="/Catalog/Employees/Index">Zaměstnanci</a>
                        <a asp-page="/Catalog/Matrices/Index">Schvalovací matice</a>
                        <a asp-page="/Catalog/AutoRules">Auto-zařazení</a>
                        <a asp-page="/Reports">Reporty</a>
                    </div>
                </details>
            }

            @if (HasRole("CardAdmin") || HasRole("ParkingAdmin"))
            {
                var queueTotal = (HasRole("CardAdmin") ? attention.CardQueue : 0) + (HasRole("ParkingAdmin") ? attention.ParkingQueue : 0);
                <details class="navmenu @(inAdmin ? "active" : "")">
                    <summary>
                        Správa
                        @if (queueTotal > 0)
                        {
                            <span class="nav-badge" title="@queueTotal položek čeká ve frontách">@queueTotal</span>
                        }
                    </summary>
                    <div class="navmenu-panel">
                        <span class="navmenu-group">Fronty</span>
                        @if (HasRole("CardAdmin"))
                        {
                            <a asp-page="/CardQueue">
                                Fronta karet
                                @if (attention.CardQueue > 0)
                                {
                                    <span class="nav-badge">@attention.CardQueue</span>
                                }
                            </a>
                        }
                        @if (HasRole("ParkingAdmin"))
                        {
                            <a asp-page="/Parking/Queue">
                                Fronta parkování
                                @if (attention.ParkingQueue > 0)
                                {
                                    <span class="nav-badge">@attention.ParkingQueue</span>
                                }
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="navmenu-group">Systém</span>
                            <a asp-page="/Admin/Users/Index">Uživatelé a role</a>
                            <a asp-page="/Admin/Automation">Automatizace</a>
                            <a asp-page="/Admin/Settings">Nastavení</a>
                            <a asp-page="/Admin/ConnectorUpdate">WIN-PAK konektor</a>
                            <a asp-page="/Admin/Audit">Audit</a>
                        }
                    </div>
                </details>
            }
        </nav>
    }

    <div class="topbar-right">
        <form method="post" action="/set-theme" class="theme-form">
            <select name="theme" onchange="this.form.submit()" aria-label="Barevné téma">
                @foreach (var (value, label) in new[]
                {
                    ("light", "Světlé"), ("dark", "Tmavé"), ("blue", "Modré"),
                    ("green", "Zelené"), ("purple", "Fialové"), ("contrast", "Kontrastní"),
                })
                {
                    <option value="@value" selected="@(theme == value)">@label</option>
                }
            </select>
        </form>

        @if (isAuthenticated)
        {
            <details class="usermenu">
                <summary class="user-badge" title="@User.Identity!.Name">
                    @(User.FindFirst("display_name")?.Value ?? User.Identity!.Name)
                </summary>
                <div class="usermenu-panel">
                    <span class="usermenu-header">@User.Identity!.Name</span>
                    <a asp-page="/Deputies">Zástupy</a>
                    @if (User.HasClaim("is_local", "1"))
                    {
                        <a asp-page="/Account/ChangePassword">Změna hesla</a>
                    }
                    <form method="post" asp-page="/Account/Login" asp-page-handler="Logout">
                        <button type="submit" class="btn btn-ghost">Odhlásit</button>
                    </form>
                </div>
            </details>
        }
    </div>
</header>

<main class="content">
    @RenderBody()
</main>

<footer class="footer">
    <span>ACS · acs.fnmh.network</span>
</footer>
<script>
// Rozbalovací nabídky (číselníky, správa, uživatel): otevřená je vždy jen jedna,
// zavírají se kliknutím jinam nebo klávesou Esc.
(() => {
    const menus = [...document.querySelectorAll('details.navmenu, details.usermenu')];
    if (menus.length === 0) return;
    const closeAll = except => menus.forEach(m => { if (m !== except) m.open = false; });
    menus.forEach(m => m.addEventListener('toggle', () => { if (m.open) closeAll(m); }));
    document.addEventListener('click', e => { if (!menus.some(m => m.contains(e.target))) closeAll(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Acs.Web.Pages.Shared.PermitCardView
<div class="permit-card">
    <div class="permit-card-band"><span>P</span></div>
    <div class="permit-card-body">
        <div class="permit-card-logo">
            <span class="permit-card-logo-mark">FN<br />M<b>+</b>H</span>
            <span class="permit-card-logo-text">Fakultní<br />nemocnice<br />Motol a Homolka</span>
        </div>
        <div class="permit-card-title">@Model.Title</div>
        <div class="permit-card-type">@Model.TypeName.ToUpperInvariant()</div>
        @if (Model.FunctionTitle is not null)
        {
            <div class="permit-card-function">@Model.FunctionTitle@(Model.HolderName is null ? "" : $" — {Model.HolderName}")</div>
        }
        <div class="permit-card-scope">@Model.ScopeText</div>
        @if (Model.Plates is not null)
        {
            <div class="permit-card-plate">@Model.Plates</div>
        }
        <div class="permit-card-meta">
            @if (Model.PermitNumber is not null)
            {
                <span>č. @Model.PermitNumber</span>
            }
            <span>@(Model.ValidTo is { } to ? $"platí do {to:d. M. yyyy}" : "platnost bez omezení")</span>
        </div>
        <div class="permit-card-footer">
            Umístěte viditelně za čelní sklo vozidla.<br />
            Fakultní nemocnice Motol a Homolka (FNMH)
        </div>
    </div>
    <div class="permit-card-watermark">FN<br />MH</div>
</div>

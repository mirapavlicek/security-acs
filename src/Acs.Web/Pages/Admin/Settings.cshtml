@page
@model Acs.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Nastavení";
}
<h1>Nastavení</h1>
<p class="muted">Veškerá konfigurace aplikace. Citlivé hodnoty se ukládají šifrovaně; prázdné pole u hesla/klíče znamená „ponechat stávající“.</p>

@if (Model.SavedSection is not null)
{
    <div class="alert alert-success">Sekce „@Model.SavedSection“ uložena.</div>
}

<div class="settings-layout" data-section="@(Model.ActiveSection ?? Model.SectionFromQuery)">
<nav class="settings-nav" aria-label="Sekce nastavení">
    <a href="#s-general" data-panel="s-general">Obecné</a>
    <a href="#s-ldap" data-panel="s-ldap">Active Directory (LDAP)</a>
    <a href="#s-sso" data-panel="s-sso">Přihlášení Windows (NTLM / Kerberos)</a>
    <a href="#s-winpak" data-panel="s-winpak">WIN-PAK konektor</a>
    <a href="#s-employees" data-panel="s-employees">Zdroj zaměstnanců</a>
    <a href="#s-automation" data-panel="s-automation">Automatizace</a>
    <a href="#s-cards" data-panel="s-cards">Karty (identifikátory zaměstnanců)</a>
    <a href="#s-parking" data-panel="s-parking">Parkovací systém (GreenCenter)</a>
    <a href="#s-smtp" data-panel="s-smtp">Notifikace (SMTP)</a>
</nav>
<div class="settings-panels">
<div class="card settings-panel" id="s-general" data-title="Obecné">
    <h2 style="margin-top:0">Obecné</h2>
    <form method="post" asp-page-handler="General">
        <label>Název aplikace</label>
        <input type="text" name="AppTitle" value="@Model.Values[SettingKeys.AppTitle]" />
        <label>Výchozí barevné téma</label>
        <select name="DefaultTheme">
            @foreach (var (t, label) in Acs.Web.Pages.Shared.Themes.All)
            {
                <option value="@t" selected="@(Model.Values[SettingKeys.DefaultTheme] == t)">@label (@t)</option>
            }
        </select>
        <button class="btn" type="submit">Uložit</button>
    </form>
</div>

<div class="card settings-panel" id="s-ldap" data-title="Active Directory (LDAP)">
    <h2 style="margin-top:0">Active Directory (LDAP)</h2>
    <form method="post" asp-page-handler="Ldap">
        <div class="checkbox-row">
            <input type="checkbox" id="LdapEnabled" name="LdapEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.LdapEnabled] == "true")" />
            <label for="LdapEnabled">Povolit přihlašování přes AD</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="LdapUseDcLocator" name="LdapUseDcLocator" value="true"
                   checked="@(Model.Values[SettingKeys.LdapUseDcLocator] != "false")" />
            <label for="LdapUseDcLocator">DC lokátor — najít aktivní řadič přes DNS SRV (_ldap._tcp.dc._msdcs.doména), s automatickým failoverem</label>
        </div>
        <label>LDAP server (fallback / ruční volba, když lokátor nic nenajde)</label>
        <input type="text" name="LdapServer" value="@Model.Values[SettingKeys.LdapServer]" placeholder="dc01.fnmh.local" />
        <label>Port</label>
        <input type="number" name="LdapPort" value="@Model.Values[SettingKeys.LdapPort]" placeholder="636" />
        <div class="checkbox-row">
            <input type="checkbox" id="LdapUseSsl" name="LdapUseSsl" value="true"
                   checked="@(Model.Values[SettingKeys.LdapUseSsl] != "false")" />
            <label for="LdapUseSsl">LDAPS (doporučeno)</label>
        </div>
        <label>Base DN</label>
        <input type="text" name="LdapBaseDn" value="@Model.Values[SettingKeys.LdapBaseDn]" placeholder="DC=fnmh,DC=local" />
        <label>Doména (UPN sufix)</label>
        <input type="text" name="LdapDomain" value="@Model.Values[SettingKeys.LdapDomain]" placeholder="fnmh.local" />
        <label>Servisní účet pro bind (UPN nebo DN) — používá se pro načítání zaměstnanců z AD</label>
        <input type="text" name="LdapBindUser" value="@Model.Values[SettingKeys.LdapBindUser]"
               placeholder="svc-acs@nnh.local" autocomplete="off" />
        <label>Heslo servisního účtu (prázdné = ponechat stávající)</label>
        <input type="password" name="LdapBindPassword" autocomplete="new-password" />
        <label>Filtr uživatele ({0} = účet)</label>
        <input type="text" name="LdapUserFilter" value="@Model.Values[SettingKeys.LdapUserFilter]"
               placeholder="(&amp;(objectClass=user)(sAMAccountName={0}))" />
        <label>Mapování AD skupin na role (řádky „Skupina=Role1,Role2“; role: Admin, CatalogManager, Approver, CardAdmin, Employee; prázdné = role se spravují ručně)</label>
        <textarea name="LdapGroupRoleMap" rows="4" placeholder="ACS-Spravci=Admin&#10;ACS-SpravciKaret=CardAdmin&#10;ACS-Schvalovatele=Approver">@Model.Values[SettingKeys.LdapGroupRoleMap]</textarea>
        <button class="btn" type="submit">Uložit</button>
    </form>
</div>

<div class="card settings-panel" id="s-sso" data-title="Přihlášení Windows (NTLM / Kerberos)">
    <h2 style="margin-top:0">Přihlášení Windows (NTLM / Kerberos)</h2>
    <p class="muted">
        Jednotné přihlášení z doménových PC: prohlížeč se prokáže účtem přihlášeného uživatele
        (<code>WWW-Authenticate: Negotiate</code> — Kerberos, případně NTLM), aplikace identitu namapuje na
        uživatele ACS a vydá běžnou přihlašovací cookie. Role se načtou z AD skupin servisním účtem
        (sekce Active Directory). Formulář se jménem a heslem zůstává dostupný — lokální
        <code>admin</code> i záloha při výpadku Kerberosu (<code>/Account/Login?manual=1</code>).
    </p>
    <form method="post" asp-page-handler="Sso">
        <div class="checkbox-row">
            <input type="checkbox" id="SsoEnabled" name="SsoEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.SsoEnabled] == "true")" />
            <label for="SsoEnabled">Povolit přihlášení účtem Windows (tlačítko na přihlašovací stránce, adresa <code>/Account/WindowsLogin</code>)</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="SsoAutoLogin" name="SsoAutoLogin" value="true"
                   checked="@(Model.Values[SettingKeys.SsoAutoLogin] == "true")" />
            <label for="SsoAutoLogin">Přihlašovat automaticky — přihlašovací stránka rovnou vyzve prohlížeč, formulář se zobrazí až po selhání nebo odhlášení</label>
        </div>
        <label>Povolené domény účtu (NetBIOS nebo DNS, oddělené čárkou; prázdné = libovolná doména, které Kerberos důvěřuje)</label>
        <input type="text" name="SsoAllowedDomains" value="@Model.Values[SettingKeys.SsoAllowedDomains]" placeholder="FNMH, fnmh.local" />
        <button class="btn" type="submit">Uložit</button>
        @if (Model.Values[SettingKeys.SsoEnabled] == "true")
        {
            <a class="btn btn-ghost" asp-page="/Account/WindowsLogin" asp-route-test="1">Otestovat přihlášení Windows</a>
        }
    </form>
    @if ((Model.SsoTestResult ?? Model.SsoTestFromQuery) is { } ssoTest)
    {
        <p class="muted">Test přihlášení Windows: @ssoTest</p>
    }

    <h3>Stav na tomto nodu</h3>
    <table class="data">
        <tbody>
            <tr><th style="width:14rem">Server</th><td>@Model.SsoHostInfo</td></tr>
            <tr>
                <th>Keytab (<code>KRB5_KTNAME</code>)</th>
                <td>
                    @if (Model.SsoKeytabPath is null)
                    {
                        <span class="badge">nenastaveno</span>
                        <span class="muted">— na Linuxu je pro Kerberos nutný keytab se SPN <code>HTTP/@Model.SsoHostName</code>; proměnná se nastavuje v <code>/etc/acs/acs.env</code>.</span>
                    }
                    else if (Model.SsoKeytabExists)
                    {
                        <code>@Model.SsoKeytabPath</code> <span class="badge badge-primary">soubor nalezen</span>
                    }
                    else
                    {
                        <code>@Model.SsoKeytabPath</code> <span class="badge badge-danger">soubor chybí nebo není čitelný</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Očekávané SPN</th>
                <td><code>HTTP/@Model.SsoHostName</code> <span class="muted">(podle adresy, na které aplikace běží — musí být zaregistrované na servisním účtu, viz <code>docs/prihlaseni-windows.md</code>)</span></td>
            </tr>
        </tbody>
    </table>
    <p class="muted">
        Postup: <code>setspn -S HTTP/@Model.SsoHostName DOMENA\svc-acs-web</code> → <code>ktpass … -out acs.keytab</code>
        → nahrát na oba nody jako <code>/etc/acs/acs.keytab</code> (vlastník <code>acs</code>, práva 600) →
        <code>KRB5_KTNAME=/etc/acs/acs.keytab</code> v <code>acs.env</code> → restart <code>acs-web</code>.
        NTLM jako záloha funguje jen při hostování na Windows; na Linuxu prohlížeč bez Kerberos ticketu
        skončí na formuláři se jménem a heslem.
    </p>
</div>

<div class="card settings-panel" id="s-winpak" data-title="WIN-PAK konektor">
    <h2 style="margin-top:0">WIN-PAK konektor</h2>
    <form method="post" asp-page-handler="WinPak">
        <label>Adresa konektoru</label>
        <input type="text" name="WinPakBaseUrl" value="@Model.Values[SettingKeys.WinPakBaseUrl]"
               placeholder="http://winpak-server:52001" />
        <label>API klíč (prázdné = ponechat)</label>
        <input type="password" name="WinPakApiKey" autocomplete="new-password" />
        <div class="checkbox-row">
            <input type="checkbox" id="WinPakSyncEnabled" name="WinPakSyncEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.WinPakSyncEnabled] == "true")" />
            <label for="WinPakSyncEnabled">Automatická synchronizace čteček</label>
        </div>
        <label>Interval synchronizace čteček (minuty)</label>
        <input type="number" name="WinPakSyncIntervalMinutes" value="@Model.Values[SettingKeys.WinPakSyncIntervalMinutes]" placeholder="60" />
        <div class="checkbox-row">
            <input type="checkbox" id="WinPakAccessSyncEnabled" name="WinPakAccessSyncEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.WinPakAccessSyncEnabled] == "true")" />
            <label for="WinPakAccessSyncEnabled">Zpětná synchronizace stavu přístupů (změny provedené přímo ve WIN-PAK se propíší do ACS)</label>
        </div>
        <label>Interval zpětné synchronizace (minuty)</label>
        <input type="number" name="WinPakAccessSyncIntervalMinutes" value="@Model.Values[SettingKeys.WinPakAccessSyncIntervalMinutes]" placeholder="15" />
        <button class="btn" type="submit">Uložit</button>
        <button class="btn btn-ghost" type="submit" asp-page-handler="WinPakTest">Otestovat spojení</button>
    </form>
    @if (Model.WinPakTestResult is not null)
    {
        <p class="muted">Test spojení: @Model.WinPakTestResult</p>
    }
    @if (Model.WinPakAdminUrl is not null)
    {
        <p class="muted">
            Nastavení samotného konektoru (režim, přihlášení operátora WIN-PAK, ProgID, diagnostika)
            se spravuje v jeho vlastní administraci:
            <a href="@Model.WinPakAdminUrl" target="_blank" rel="noopener">@Model.WinPakAdminUrl</a>.
        </p>
    }
</div>

<div class="card settings-panel" id="s-employees" data-title="Zdroj zaměstnanců">
    <h2 style="margin-top:0">Zdroj zaměstnanců</h2>
    <form method="post" asp-page-handler="Employees">
        <label>Režim (Ad = načítání z Active Directory; používá LDAP nastavení a servisní účet)</label>
        <select name="EmployeeSourceMode">
            @foreach (var m in new[] { "None", "Ad", "Mssql", "Api" })
            {
                <option value="@m" selected="@(Model.Values[SettingKeys.EmployeeSourceMode] == m)">@m</option>
            }
        </select>
        <label>LDAP filtr zaměstnanců (režim Ad; výchozí = aktivní uživatelé)</label>
        <input type="text" name="EmployeeLdapFilter" value="@Model.Values[SettingKeys.EmployeeLdapFilter]"
               placeholder="(&amp;(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))" />
        <label>AD atribut s osobním číslem (víc oddělte čárkou — bere se první neprázdný)</label>
        <input type="text" name="EmployeePersonalNumberAttribute"
               value="@Model.Values[SettingKeys.EmployeePersonalNumberAttribute]"
               placeholder="employeeID, employeeNumber" />
        <p class="hint">
            Každé AD má osobní číslo jinde. Čím ho vaše doména plní, zjistíte na stránce
            <a asp-page="LdapDump">Co vrací AD o účtu</a> — vypíše všechny atributy jednoho
            účtu i to, co z nich ACS uloží.
        </p>
        <label>Velikost stránky LDAP dotazu (AD zvládá max 1000)</label>
        <input type="number" name="EmployeeLdapPageSize" value="@Model.Values[SettingKeys.EmployeeLdapPageSize]" placeholder="500" />
        <label>Timeout LDAP dotazu (minuty) — velké domény trvají déle</label>
        <input type="number" name="EmployeeLdapTimeoutMinutes" value="@Model.Values[SettingKeys.EmployeeLdapTimeoutMinutes]" placeholder="10" />
        <label>MSSQL connection string (prázdné = ponechat)</label>
        <input type="password" name="EmployeeMssqlConnectionString" autocomplete="new-password" />
        <label>MSSQL dotaz (sloupce: ExternalId, PersonalNumber, FirstName, LastName, Email, Department, AdAccount, CardNumber)</label>
        <textarea name="EmployeeMssqlQuery" rows="3">@Model.Values[SettingKeys.EmployeeMssqlQuery]</textarea>
        <label>API URL (alternativa k MSSQL)</label>
        <input type="text" name="EmployeeApiUrl" value="@Model.Values[SettingKeys.EmployeeApiUrl]" />
        <label>API klíč (prázdné = ponechat)</label>
        <input type="password" name="EmployeeApiKey" autocomplete="new-password" />
        <button class="btn" type="submit">Uložit</button>
    </form>
</div>

<div class="card settings-panel" id="s-automation" data-title="Automatizace">
    <h2 style="margin-top:0">Automatizace</h2>
    <p class="muted">Co má systém dělat sám, bez zásahu obsluhy. Přehled stavu je na stránce <a asp-page="Automation">Automatizace</a>.</p>
    <form method="post" asp-page-handler="Automation">
        <div class="checkbox-row">
            <input type="checkbox" id="AutomationEnabled" name="AutomationEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutomationEnabled] != "false")" />
            <label for="AutomationEnabled">Zapnout automatizaci</label>
        </div>
        <label>Interval vyhodnocení (minuty)</label>
        <input type="number" name="AutomationIntervalMinutes" value="@Model.Values[SettingKeys.AutomationIntervalMinutes]" placeholder="30" />

        <div class="checkbox-row">
            <input type="checkbox" id="AutoOffboardingEnabled" name="AutoOffboardingEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutoOffboardingEnabled] != "false")" />
            <label for="AutoOffboardingEnabled">Offboarding — odebrat přístupy zaměstnanci, který zmizel z AD</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="AutoDepartmentChangeEnabled" name="AutoDepartmentChangeEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutoDepartmentChangeEnabled] != "false")" />
            <label for="AutoDepartmentChangeEnabled">Změna oddělení — odebrat přístup přidělený podle starého oddělení</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="AutoExpirationEnabled" name="AutoExpirationEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutoExpirationEnabled] != "false")" />
            <label for="AutoExpirationEnabled">Expirace — odebrat přístup po uplynutí platnosti</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="AutoRemindersEnabled" name="AutoRemindersEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutoRemindersEnabled] != "false")" />
            <label for="AutoRemindersEnabled">Připomínky a eskalace dlouho čekajících schválení</label>
        </div>
        <label>Připomínka po (dnech)</label>
        <input type="number" name="AutoReminderAfterDays" value="@Model.Values[SettingKeys.AutoReminderAfterDays]" placeholder="3" />
        <label>Eskalace na administrátory po (dnech)</label>
        <input type="number" name="AutoEscalationAfterDays" value="@Model.Values[SettingKeys.AutoEscalationAfterDays]" placeholder="7" />

        <div class="checkbox-row">
            <input type="checkbox" id="AutoPushEnabled" name="AutoPushEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.AutoPushEnabled] == "true")" />
            <label for="AutoPushEnabled">Automaticky předávat schválené přístupy do WIN-PAK (bez kliknutí správce karet)</label>
        </div>
        <button class="btn" type="submit">Uložit</button>
    </form>
</div>

<div class="card settings-panel" id="s-cards" data-title="Karty (identifikátory zaměstnanců)">
    <h2 style="margin-top:0">Karty (identifikátory zaměstnanců)</h2>
    <p class="muted">Zaměstnanci se načítají z AD; čísla karet buď z MSSQL dotazu, nebo z integrační služby, která se ptá po osobním čísle.</p>
    @if (Model.CardsApiProbe is not null)
    {
        <div class="alert @(Model.CardsApiProbe.StartsWith("Přečteno") ? "alert-success" : "alert-error")" style="white-space:pre-wrap;font-family:var(--mono, monospace);font-size:0.85rem">@Model.CardsApiProbe</div>
    }
    <form method="post" asp-page-handler="Cards">
        <label>Zdroj karet</label>
        @{ var cardsSource = Model.Values[SettingKeys.CardsSource] ?? "Mssql"; }
        <select name="CardsSource" id="cards-source">
            <option value="Mssql" selected="@(cardsSource != "Api")">MSSQL dotaz</option>
            <option value="Api" selected="@(cardsSource == "Api")">Integrační API (POST …/Identifiers po osobním čísle)</option>
        </select>

        <fieldset style="border:1px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;margin:0.6rem 0">
            <legend class="muted">Integrační API</legend>
            <p class="hint">Na adresu se pro každého zaměstnance pošle <span class="mono">POST { "employeeNo": "&lt;osobní číslo&gt;", "idIdentifierSubType": 3 }</span>; 3 = identifikační karta. Zaměstnanec bez karty smí vrátit 404.</p>
            <label>Adresa</label>
            <input type="text" name="CardsApiUrl" value="@Model.Values[SettingKeys.CardsApiUrl]" placeholder="https://ws-integrations.nnh.local/api/v0/Identifiers" />
            <label>Podtyp identifikátoru (idIdentifierSubType)</label>
            <input type="number" name="CardsApiSubType" value="@(Model.Values[SettingKeys.CardsApiSubType] ?? "3")" style="width:8rem" />
            <label>Přihlášení</label>
            @{ var cardsAuth = Model.Values[SettingKeys.CardsApiAuth] ?? "None"; }
            <select name="CardsApiAuth">
                <option value="None" selected="@(cardsAuth == "None")">bez přihlášení</option>
                <option value="Token" selected="@(cardsAuth == "Token")">Token z přihlášení (POST uživatel + heslo na endpoint služby, pak Bearer)</option>
                <option value="Bearer" selected="@(cardsAuth == "Bearer")">Pevný token (Authorization: Bearer)</option>
                <option value="Windows" selected="@(cardsAuth == "Windows")">Windows účet domény (NTLM/Negotiate)</option>
                <option value="ApiKey" selected="@(cardsAuth == "ApiKey")">API klíč v hlavičce</option>
                <option value="Basic" selected="@(cardsAuth == "Basic")">Basic (uživatel a heslo)</option>
            </select>
            <p class="hint">Služba Identifiers odpovídá „No valid token available“ — chce token. Buď ho vydává natrvalo (<em>Pevný token</em>), nebo se získává přihlášením (<em>Token z přihlášení</em>): adresu přihlašovacího endpointu a tvar těla najdete ve Swaggeru služby. U <em>Token</em> a <em>Windows</em> se bez vyplněného uživatele použije servisní účet pro bind do AD.</p>
            <label>Pevný token (prázdné = ponechat)</label>
            <input type="password" name="CardsApiBearerToken" autocomplete="new-password" />
            <label>Přihlašovací endpoint (pro Token z přihlášení)</label>
            <input type="text" name="CardsApiTokenUrl" value="@Model.Values[SettingKeys.CardsApiTokenUrl]" placeholder="https://ws-integrations.nnh.local/api/v0/Auth/Login" />
            <label>Tělo přihlášení — <span class="mono">{user}</span> a <span class="mono">{password}</span> se nahradí (prázdné = výchozí)</label>
            <input type="text" name="CardsApiTokenBody" class="mono" value="@Model.Values[SettingKeys.CardsApiTokenBody]" placeholder='{"username":"{user}","password":"{password}"}' />
            <label>Pole s tokenem v odpovědi (prázdné = najde se: token, accessToken, access_token, jwt…)</label>
            <input type="text" name="CardsApiTokenField" value="@Model.Values[SettingKeys.CardsApiTokenField]" placeholder="token" style="width:14rem" />
            <label>Hlavička s API klíčem (prázdné = X-Api-Key)</label>
            <input type="text" name="CardsApiKeyHeader" value="@Model.Values[SettingKeys.CardsApiKeyHeader]" placeholder="X-Api-Key" />
            <label>API klíč (prázdné = ponechat)</label>
            <input type="password" name="CardsApiKey" autocomplete="new-password" />
            <label>Uživatel (Basic, Token z přihlášení, nebo jiný Windows účet než pro AD)</label>
            <input type="text" name="CardsApiUser" value="@Model.Values[SettingKeys.CardsApiUser]" autocomplete="off" placeholder="prázdné = účet z nastavení AD" />
            <label>Heslo (prázdné = ponechat)</label>
            <input type="password" name="CardsApiPassword" autocomplete="new-password" />
            <div class="checkbox-row">
                <input type="checkbox" id="CardsApiIgnoreTls" name="CardsApiIgnoreTls" value="true"
                       checked="@(Model.Values[SettingKeys.CardsApiIgnoreTls] == "true")" />
                <label for="CardsApiIgnoreTls">Neověřovat certifikát TLS (interní CA, kterou nody neznají — raději CA nainstalujte)</label>
            </div>
        </fieldset>

        <fieldset style="border:1px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;margin:0.6rem 0">
            <legend class="muted">MSSQL dotaz</legend>
            <p class="hint">Dotaz vrací řádek na identifikátor: AdAccount nebo PersonalNumber (párování), CardNumber/Value, volitelně Type, WinPakCardHolderId, ValidFrom, ValidTo.</p>
            <label>MSSQL connection string (prázdné = ponechat)</label>
            <input type="password" name="CardsMssqlConnectionString" autocomplete="new-password" />
            <label>SQL dotaz</label>
            <textarea name="CardsMssqlQuery" rows="3">@Model.Values[SettingKeys.CardsMssqlQuery]</textarea>
        </fieldset>
        <div class="checkbox-row">
            <input type="checkbox" id="CardsSyncEnabled" name="CardsSyncEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.CardsSyncEnabled] == "true")" />
            <label for="CardsSyncEnabled">Automatická synchronizace karet</label>
        </div>
        <label>Interval (minuty)</label>
        <input type="number" name="CardsSyncIntervalMinutes" value="@Model.Values[SettingKeys.CardsSyncIntervalMinutes]" placeholder="60" />
        <button class="btn" type="submit">Uložit</button>
    </form>
    <form method="post" asp-page-handler="CardsApiTest" class="inline-form" style="margin-top:0.8rem">
        <label>Zkouška integračního API — osobní číslo</label>
        <input type="text" name="employeeNo" placeholder="např. 13483" style="width:12rem" />
        <button class="btn btn-sm btn-ghost" type="submit">Vyzkoušet (uložené nastavení)</button>
    </form>
</div>

<div class="card settings-panel" id="s-parking" data-title="Parkovací systém (GreenCenter)">
    <h2 style="margin-top:0">Parkovací systém (GreenCenter)</h2>
    <p class="muted">
        Vjezdy na SPZ. Parkovací systém se dotazuje ACS přes integrační API
        <code>@Model.IntegrationApiUrl</code> (hlavička <code>X-Api-Key</code>) — online autorizace
        u brány, hlášení průjezdů a čtení povolení; ACS naopak může vydaná povolení předávat
        konektoru systému. Postup napojení: <a asp-page="/Admin/IntegrationEvents">události z brány</a>,
        <code>docs/integrace/greencenter.md</code>. Areály se na vjezdy párují v Číselníky → Areály
        (pole „Vjezdy v parkovacím systému“).
    </p>
    <form method="post" asp-page-handler="ParkingSystem">
        <div class="checkbox-row">
            <input type="checkbox" id="ParkingSystemEnabled" name="ParkingSystemEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.ParkingSystemEnabled] == "true")" />
            <label for="ParkingSystemEnabled">Integrační API zapnuté (bez klíče zůstává zavřené)</label>
        </div>
        <label>API klíč, kterým se parkovací systém prokazuje ACS (prázdné = ponechat@(Model.ParkingApiKeySet ? ", nastaveno" : ", zatím nenastaveno"))</label>
        <input type="password" name="ParkingSystemApiKey" autocomplete="new-password" />
        <label>Povolené IP adresy volajícího (oddělené čárkou, i s maskou; prázdné = bez omezení)</label>
        <input type="text" name="ParkingSystemAllowedIps" value="@Model.Values[SettingKeys.ParkingSystemAllowedIps]"
               placeholder="10.20.30.5, 10.20.31.0/24" />
        <label>Keš rozhodnutí při výpadku ACS (sekundy, 0 = nekešovat)</label>
        <input type="number" name="ParkingSystemCacheTtlSeconds" value="@Model.Values[SettingKeys.ParkingSystemCacheTtlSeconds]" placeholder="300" />
        <div class="checkbox-row">
            <input type="checkbox" id="ParkingSystemExitAlwaysAllowed" name="ParkingSystemExitAlwaysAllowed" value="true"
                   checked="@(Model.Values[SettingKeys.ParkingSystemExitAlwaysAllowed] != "false")" />
            <label for="ParkingSystemExitAlwaysAllowed">Výjezd povolit vždy (vozidlo nesmí zůstat zavřené v areálu; důvod se zaznamená)</label>
        </div>
        <h3>Konektor parkovacího systému (zápis povolení — vzor A)</h3>
        <label>Adresa konektoru (prázdné = ACS do systému nezapisuje)</label>
        <input type="text" name="ParkingSystemConnectorBaseUrl" value="@Model.Values[SettingKeys.ParkingSystemConnectorBaseUrl]"
               placeholder="https://parking-connector:8443" />
        <label>API klíč konektoru (prázdné = ponechat)</label>
        <input type="password" name="ParkingSystemConnectorApiKey" autocomplete="new-password" />
        <div class="checkbox-row">
            <input type="checkbox" id="ParkingSystemPushEnabled" name="ParkingSystemPushEnabled" value="true"
                   checked="@(Model.Values[SettingKeys.ParkingSystemPushEnabled] == "true")" />
            <label for="ParkingSystemPushEnabled">Předávat vydaná a odebraná povolení do konektoru automaticky</label>
        </div>
        <button class="btn" type="submit">Uložit</button>
        <button class="btn btn-ghost" type="submit" asp-page-handler="ParkingSystemTest">Otestovat konektor</button>
    </form>
    @if (Model.ParkingSystemTestResult is not null)
    {
        <p class="muted">Test konektoru: @Model.ParkingSystemTestResult</p>
    }
</div>

<div class="card settings-panel" id="s-smtp" data-title="Notifikace (SMTP)">
    <h2 style="margin-top:0">Notifikace (SMTP)</h2>
    <form method="post" asp-page-handler="Smtp">
        <label>SMTP server</label>
        <input type="text" name="SmtpHost" value="@Model.Values[SettingKeys.SmtpHost]" />
        <label>Port</label>
        <input type="number" name="SmtpPort" value="@Model.Values[SettingKeys.SmtpPort]" placeholder="25" />
        <label>Uživatel</label>
        <input type="text" name="SmtpUser" value="@Model.Values[SettingKeys.SmtpUser]" />
        <label>Heslo (prázdné = ponechat)</label>
        <input type="password" name="SmtpPassword" autocomplete="new-password" />
        <label>Odesílatel</label>
        <input type="email" name="SmtpFrom" value="@Model.Values[SettingKeys.SmtpFrom]" placeholder="acs@fnmh.network" />
        <div class="checkbox-row">
            <input type="checkbox" id="SmtpUseTls" name="SmtpUseTls" value="true"
                   checked="@(Model.Values[SettingKeys.SmtpUseTls] == "true")" />
            <label for="SmtpUseTls">TLS</label>
        </div>
        <button class="btn" type="submit">Uložit</button>
    </form>
</div>
</div>
</div>

@section Scripts {
<script>
// Nastavení jako menu vlevo a jedno okno vpravo: zobrazí se jen zvolená sekce.
// Sekce je v adrese (#s-karty), po uložení se vrátí ta uložená; bez JS zůstávají všechny.
(() => {
    const layout = document.querySelector('.settings-layout');
    const links = [...document.querySelectorAll('.settings-nav a')];
    const panels = [...document.querySelectorAll('.settings-panel')];
    if (!layout || panels.length === 0) return;
    layout.classList.add('settings-js');

    const show = (id, push) => {
        const target = panels.some(p => p.id === id) ? id : panels[0].id;
        for (const panel of panels) panel.classList.toggle('active', panel.id === target);
        for (const link of links) link.classList.toggle('active', link.dataset.panel === target);
        if (push && location.hash !== '#' + target) history.replaceState(null, '', '#' + target);
    };

    for (const link of links) {
        link.addEventListener('click', e => { e.preventDefault(); show(link.dataset.panel, true); });
    }
    window.addEventListener('hashchange', () => show(location.hash.slice(1), false));

    const initial = location.hash ? location.hash.slice(1) : (layout.dataset.section ? 's-' + layout.dataset.section : panels[0].id);
    show(initial, true);
})();
</script>
}

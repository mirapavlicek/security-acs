@page
@using Acs.Domain.Entities
@using Acs.Web.Pages.Shared
@model Acs.Web.Pages.MyAccessModel
@{
    ViewData["Title"] = "Moje přístupy";
    var now = DateTime.UtcNow;
}
<h1>Moje přístupy</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@if (Model.Employee is null)
{
    <div class="card">
        <p class="muted">K vašemu účtu není přiřazen žádný zaměstnanec — kontaktujte správce číselníků
        (párování probíhá podle AD účtu v kartě zaměstnance).</p>
        <p class="muted">Po spárování tu uvidíte své přístupy ke dveřím, identifikátory (karty, SPZ),
        vjezdy a parkovací povolení i poslední průjezdy bránou.</p>
    </div>
}
else
{
    <p class="muted">
        Přístupy zaměstnance @Model.Employee.FullName
        @if (Model.Employee.PersonalNumber is { Length: > 0 })
        {
            <text>(os. číslo @Model.Employee.PersonalNumber)</text>
        }
        — dveře podle WIN-PAK, vjezdy podle vydaných parkovacích povolení.
        @if (Model.Employee.Manager is { } manager)
        {
            <br /><text>Váš nadřízený: <strong>@manager.FullName</strong></text>
            <span title="Podle Active Directory; schvaluje vaše žádosti, kde to matice vyžaduje.">ⓘ</span>
        }
        <br /><text>Kategorie pro schvalování: <strong>@Model.Employee.EffectiveRank.Label()</strong></text>
        @if (Model.Employee.OrgUnit is { } unit)
        {
            <text>, úsek: <strong>@unit.DisplayName</strong></text>
        }
        <span title="Podle kategorie a úseku matice rozlišuje vstup v rámci vlastního / mimo vlastní úsek a přeskakuje či přidává schvalovací stupně.">ⓘ</span>
    </p>

    <h2>Identifikátory</h2>
    <div class="card">
        <table class="data">
            <thead><tr><th>Druh</th><th>Hodnota</th><th>Stav</th><th>Platnost</th><th>Poznámka</th></tr></thead>
            <tbody>
            @foreach (var identifier in Model.Identifiers)
            {
                var valid = identifier.IsValidAt(now);
                <tr class="@(valid ? "" : "muted")">
                    <td>@MyAccessModel.IdentifierTypeName(identifier.Type)</td>
                    <td><code>@identifier.Value</code></td>
                    <td>
                        @if (valid)
                        {
                            <span class="badge badge-primary">platí</span>
                        }
                        else if (!identifier.IsActive)
                        {
                            <span class="badge">neaktivní</span>
                        }
                        else
                        {
                            <span class="badge">mimo platnost</span>
                        }
                    </td>
                    <td class="muted">
                        @if (identifier.ValidFrom is null && identifier.ValidTo is null)
                        {
                            <text>bez omezení</text>
                        }
                        else
                        {
                            <text>@(identifier.ValidFrom?.ToString("d. M. yyyy") ?? "…") – @(identifier.ValidTo?.ToString("d. M. yyyy") ?? "bez omezení")</text>
                        }
                    </td>
                    <td class="muted">@identifier.Note</td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Identifiers.Count == 0)
        {
            <p class="muted">
                Žádné identifikátory. Karta se načítá ze zdroje karet, SPZ vzniká vydáním parkovacího povolení
                (<a asp-page="/Parking/New">požádat</a>) nebo ji doplní správce číselníků v kartě zaměstnance.
            </p>
        }
    </div>

    <h2>Vjezdy a parkování</h2>
    <div class="card">
        @if (Model.ParkingItems.Count > 0)
        {
            <p class="muted" style="margin-top:0">
                Vjezd právě teď platí do:
                @if (Model.AllSitesAccessible)
                {
                    <strong>všech areálů</strong>
                }
                else if (Model.AccessibleSites.Count == 0)
                {
                    <strong>žádného areálu</strong> <span>(povolení jsou mimo platnost)</span>
                }
                else
                {
                    @foreach (var site in Model.AccessibleSites)
                    {
                        <span class="badge badge-primary">@site.Name</span>
                    }
                }
            </p>
        }
        <table class="data">
            <thead><tr><th>Číslo</th><th>Druh</th><th>SPZ / funkce</th><th>Areály (vjezdy)</th><th>Místo</th><th>Platnost</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.ParkingItems)
            {
                var permit = item.ParkingPermit!;
                var valid = permit.IsValidAt(now);
                <tr class="@(valid ? "" : "muted")">
                    <td><a asp-page="/Parking/Permit" asp-route-id="@permit.Id">@(permit.PermitNumber ?? "—")</a></td>
                    <td>@permit.PermitType?.Name</td>
                    <td>@permit.SubjectText()</td>
                    <td>@permit.SitesText()</td>
                    <td>@(permit.ParkingSpot is { } spot ? spot.DisplayName() : "—")</td>
                    <td class="muted">
                        @permit.ValidFrom.ToString("d. M. yyyy") – @(permit.ValidTo?.ToString("d. M. yyyy") ?? "bez omezení")
                        @if (!valid)
                        {
                            <span class="badge">mimo platnost</span>
                        }
                    </td>
                    <td style="white-space:nowrap">
                        @if (permit.PermitType?.PrintsWindshieldCard == true)
                        {
                            <a class="btn btn-sm btn-ghost" asp-page="/Parking/Print" asp-route-id="@permit.Id" target="_blank">Kartička (PDF)</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.ParkingItems.Count == 0)
        {
            <p class="muted">Nemáte vydané žádné parkovací povolení — bez něj brána SPZ nepustí.</p>
        }
        @if (Model.PendingParkingItems.Count > 0)
        {
            <h3>Čeká na vyřízení</h3>
            <table class="data">
                <thead><tr><th>Žádost</th><th>Druh</th><th>SPZ / funkce</th><th>Areály</th><th>Stav</th></tr></thead>
                <tbody>
                @foreach (var item in Model.PendingParkingItems)
                {
                    var permit = item.ParkingPermit!;
                    <tr>
                        <td><a asp-page="/Requests/Detail" asp-route-id="@item.RequestId">#@item.RequestId</a></td>
                        <td>@permit.PermitType?.Name</td>
                        <td>@permit.SubjectText()</td>
                        <td>@permit.SitesText()</td>
                        <td><span class="@StatusText.PillClass(item.Status)">@StatusText.Label(item)</span></td>
                    </tr>
                }
                </tbody>
            </table>
        }
        <p class="muted" style="margin-bottom:0">
            <a asp-page="/Parking/Index">Parkování — žádost o povolení, odebrání, historie</a>
        </p>
    </div>

    @if (Model.RecentGateEvents.Count > 0)
    {
        <h2>Poslední průjezdy bránou</h2>
        <div class="card">
            <table class="data">
                <thead><tr><th>Kdy</th><th>Areál / vjezd</th><th>SPZ / karta</th><th>Výsledek</th><th>Důvod</th></tr></thead>
                <tbody>
                @foreach (var e in Model.RecentGateEvents)
                {
                    <tr>
                        <td class="muted">@e.OccurredAt.ToLocalTime().ToString("d. M. yyyy H:mm")</td>
                        <td>@(e.Site?.Name ?? e.AccessPointId ?? "—")</td>
                        <td><code>@e.CredentialValue</code></td>
                        <td><span class="badge @(e.Decision == "deny" ? "badge-danger" : "badge-primary")">@MyAccessModel.GateEventText(e)</span></td>
                        <td class="muted">@MyAccessModel.ReasonText(e.DecisionReason)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h2>Aktivní přístupy (dveře)</h2>
    <div class="card">
        <table class="data">
            <thead><tr><th>Čtečka</th><th>Umístění</th><th>Stav</th><th>Od</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.ActiveItems)
            {
                var displayName = item.Reader?.Name ?? $"Skupina: {item.ReaderGroup?.Name}";
                <tr>
                    <td>@displayName</td>
                    <td class="muted">@(item.Reader?.LocationPath() ?? "—")</td>
                    <td><span class="badge badge-primary">@(item.Status == RequestStatus.PushedToWinPak ? "v systému (API)" : "v systému (ručně)")</span></td>
                    <td class="muted">@item.PushedAt?.ToString("yyyy-MM-dd")</td>
                    <td style="width:1%">
                        <form method="post" asp-page-handler="Revoke" class="inline-form">
                            <input type="hidden" name="readerId" value="@item.ReaderId" />
                            <input type="hidden" name="groupId" value="@item.ReaderGroupId" />
                            <button class="btn btn-sm btn-ghost" type="submit"
                                    onclick="return confirm('Požádat o odebrání přístupu @displayName?')">Požádat o odebrání</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.ActiveItems.Count == 0)
        {
            <p class="muted">Žádné aktivní přístupy.</p>
        }
    </div>

    <h2>Čeká na vyřízení</h2>
    <div class="card">
        <table class="data">
            <thead><tr><th>Čtečka</th><th>Stav</th><th>Žádost</th></tr></thead>
            <tbody>
            @foreach (var item in Model.PendingItems)
            {
                <tr>
                    <td>@(item.Reader?.Name ?? $"Skupina: {item.ReaderGroup?.Name}")</td>
                    <td>@(item.Status == RequestStatus.Pending ? $"schvalování — úroveň {item.CurrentLevelOrder}" : "u správce karet")</td>
                    <td><a class="btn btn-sm btn-ghost" asp-page="/Requests/Detail" asp-route-id="@item.RequestId">#@item.RequestId</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.PendingItems.Count == 0)
        {
            <p class="muted">Nic nečeká na vyřízení.</p>
        }
    </div>

    @if (Model.SecurityItems.Count > 0)
    {
        <h2>Kamery / EZS</h2>
        <div class="card">
            <table class="data">
                <thead><tr><th>Požadavek</th><th>Umístění</th><th>Stav</th><th>Žádost</th></tr></thead>
                <tbody>
                @foreach (var item in Model.SecurityItems)
                {
                    <tr>
                        <td>@item.SecurityRequest!.Title <span class="muted">(@item.SecurityRequest.KindLabel)</span></td>
                        <td class="muted">@item.SecurityRequest.LocationPath()</td>
                        <td>@Acs.Web.Pages.Shared.StatusText.Label(item)</td>
                        <td><a class="btn btn-sm btn-ghost" asp-page="/Requests/Detail" asp-route-id="@item.RequestId">#@item.RequestId</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

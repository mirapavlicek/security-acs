@page "{id:int}"
@model Acs.Web.Pages.Catalog.FloorPlanModel
@{
    ViewData["Title"] = $"Plán: {Model.Floor.Building?.Name} / {Model.Floor.Name}";
}
<h1>@ViewData["Title"]</h1>
<p class="muted">
    Interaktivní editor: místnosti přetahujte myší (roh vpravo dole mění velikost),
    čtečky a zařízení přetahujte jako ikony. Neumístěné prvky přidáte tlačítky.
    Podkladový obrázek (např. export z CAD) je volitelný — nahrává se v Budovách.
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="card">
    <h2 style="margin-top:0">Vygenerovat plán z dat</h2>
    <p class="muted">
        @if (Model.HasDrawingSource)
        {
            <text>
                Patro má polohy z projektových výkresů, takže vygenerovaný plán bude
                odpovídat skutečnému rozložení budovy.
            </text>
        }
        else
        {
            <text>
                Patro nemá polohy z výkresů (nevznikly importem z DPS), proto se sestaví
                schéma podle chodeb — místnosti jedné chodby v jednom pásu.
            </text>
        }
        @if (Model.UnplacedRooms > 0 || Model.UnplacedReaders > 0)
        {
            <text>
                Bez pozice je @Model.UnplacedRooms místností a @Model.UnplacedReaders čteček.
            </text>
        }
    </p>
    <form method="post" asp-page-handler="Generate" class="inline-form">
        <input type="hidden" name="id" value="@Model.Floor.Id" />
        <button class="btn" type="submit" name="onlyEmpty" value="true">Generuj chybějící</button>
        <button class="btn btn-ghost" type="submit" name="onlyEmpty" value="false"
                onclick="return confirm('Přerovnat celé patro? Ruční úpravy pozic se přepíší.')">
            Generuj celé patro
        </button>
    </form>
    <p class="hint" style="margin-bottom:0">
        „Generuj chybějící“ doplní jen prvky bez pozice a ruční práci nechá být.
        Vygenerované rozvržení je výchozí návrh — dál se dá upravit myší níže.
    </p>
</div>

<div class="card">
    <div style="margin-bottom:0.6rem">
        <button class="btn" id="save-btn" type="button">Uložit plán</button>
        <span id="save-info" class="muted"></span>
        <span style="float:right">
            <select id="device-type" style="max-width:130px;display:inline-block">
                <option value="Camera">Kamera</option>
                <option value="Ezs">EZS</option>
                <option value="Rozhlas">Rozhlas</option>
                <option value="Tv">TV</option>
            </select>
            <input type="text" id="device-name" placeholder="název zařízení" style="max-width:160px;display:inline-block" />
            <button class="btn btn-sm" id="add-device" type="button">Přidat zařízení</button>
        </span>
    </div>

    <div id="unplaced" style="margin-bottom:0.6rem"></div>

    <div style="margin-bottom:0.4rem">
        <button class="btn btn-sm btn-ghost" type="button" id="zoom-in" title="Přiblížit">+</button>
        <button class="btn btn-sm btn-ghost" type="button" id="zoom-out" title="Oddálit">−</button>
        <button class="btn btn-sm btn-ghost" type="button" id="zoom-reset">Celé patro</button>
        <span class="muted" id="zoom-info"></span>
    </div>

    <div style="border:1px solid var(--border);background:var(--surface)">
        <svg id="plan" viewBox="0 0 100 100" preserveAspectRatio="none"
             style="display:block;width:100%;aspect-ratio:4/3;touch-action:none">
            <g id="plan-content">
                @if (Model.HasUnderlay)
                {
                    <image href="/floors/@Model.Floor.Id/schema" x="0" y="0" width="100" height="100"
                           preserveAspectRatio="none" opacity="0.45" data-plan-background="1" />
                }
                <g id="layer-rooms"></g>
                <g id="layer-devices"></g>
            </g>
        </svg>
    </div>
    <p class="hint">
        Kolečkem myši přiblížíte, tažením podkladu posunete plán. Ve hustých patrech
        se popisky dopisují až po přiblížení — celý název je vždy v bublině.
    </p>
    <p class="muted" style="margin-bottom:0">
        Legenda: <span style="color:#0b6bcb">■ místnost</span> ·
        <span style="color:#2e7d32">● čtečka</span> ·
        <span style="color:#b26a00">◆ kamera</span> ·
        <span style="color:#c62828">◆ EZS</span> ·
        <span style="color:#6a3cb5">◆ rozhlas</span> ·
        <span style="color:#00695c">◆ TV</span>
    </p>
    <a class="btn btn-ghost" asp-page="Places" style="margin-top:0.6rem">Zpět na Budovy</a>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/plan-view.js"></script>
<script>
(() => {
    const layout = @Html.Raw(Model.LayoutJson);
    const svg = document.getElementById('plan');
    const content = document.getElementById('plan-content');
    const roomsLayer = document.getElementById('layer-rooms');
    const devicesLayer = document.getElementById('layer-devices');
    const NS = 'http://www.w3.org/2000/svg';
    const deviceColors = { Camera: '#b26a00', Ezs: '#c62828', Rozhlas: '#6a3cb5', Tv: '#00695c' };
    const deviceLabels = { Camera: 'K', Ezs: 'E', Rozhlas: 'R', Tv: 'TV' };
    let dirty = false;

    function svgPoint(evt) {
        const p = plan.toPlan(evt.clientX, evt.clientY);
        return { x: Math.max(0, Math.min(100, p.x)), y: Math.max(0, Math.min(100, p.y)) };
    }

    function el(tag, attrs, text) {
        const e = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
        if (text) e.textContent = text;
        return e;
    }

    // --- tažení ---
    let drag = null; // { move(dx,dy points), start:{x,y} }
    svg.addEventListener('pointermove', evt => {
        if (!drag) return;
        const p = svgPoint(evt);
        drag.move(p.x - drag.start.x, p.y - drag.start.y);
        drag.start = p;
        dirty = true;
        render();
    });
    const endDrag = () => { drag = null; };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointerleave', endDrag);

    function startDrag(evt, move) {
        evt.preventDefault();
        svg.setPointerCapture?.(evt.pointerId);
        drag = { move, start: svgPoint(evt) };
    }

    // Patro má i přes dvě stě místností — na plán se vejde jen číslo místnosti,
    // celý název je v bublině. Do malých obdélníků se popisek nekreslí vůbec.
    function shortLabel(name) {
        return name.split('\u2014')[0].trim() || name;
    }

    // --- vykreslení ---
    function render() {
        roomsLayer.replaceChildren();
        devicesLayer.replaceChildren();

        for (const room of layout.rooms.filter(r => r.x != null)) {
            const g = el('g', { cursor: 'move' });
            const w = room.w ?? 12, h = room.h ?? 9;
            const rect = el('rect', {
                x: room.x, y: room.y, width: w, height: h,
                fill: 'rgba(11,107,203,0.13)', stroke: '#0b6bcb', 'stroke-width': 0.35, rx: 0.6,
                'vector-effect': 'non-scaling-stroke',
            });
            rect.append(el('title', {}, room.name));
            const text = shortLabel(room.name);
            const size = Math.min(h * 0.5, w / Math.max(text.length, 1) * 1.7);
            const label = el('text', {
                x: room.x + w / 2, y: room.y + h / 2 + size * 0.35,
                'font-size': size.toFixed(2), fill: '#0b6bcb',
                'text-anchor': 'middle', 'pointer-events': 'none',
                'data-plan-label': size.toFixed(2),
            }, text);
            // Úchyt pro změnu velikosti se nesmí vejít mimo malou místnost.
            const grip = Math.min(1.6, w * 0.35, h * 0.35);
            const handle = el('rect', {
                x: room.x + w - grip, y: room.y + h - grip,
                width: grip, height: grip, fill: '#0b6bcb', cursor: 'nwse-resize',
            });
            rect.addEventListener('pointerdown', e => startDrag(e, (dx, dy) => {
                room.x = Math.max(0, Math.min(100 - (room.w ?? 12), room.x + dx));
                room.y = Math.max(0, Math.min(100 - (room.h ?? 9), room.y + dy));
            }));
            handle.addEventListener('pointerdown', e => {
                e.stopPropagation();
                startDrag(e, (dx, dy) => {
                    room.w = Math.max(1.5, Math.min(100 - room.x, (room.w ?? 12) + dx));
                    room.h = Math.max(1.5, Math.min(100 - room.y, (room.h ?? 9) + dy));
                });
            });
            g.append(rect, label, handle);
            roomsLayer.append(g);
        }

        for (const reader of layout.readers.filter(r => r.x != null)) {
            const g = el('g', { cursor: 'move', 'data-plan-marker': `${reader.x},${reader.y}` });
            const dot = el('circle', { r: 1.1, fill: '#2e7d32', stroke: '#fff', 'stroke-width': 0.25 });
            dot.append(el('title', {}, reader.name));
            // Název čtečky obsahuje i místnost, takže na plánu stačí kód před pomlčkou.
            const label = el('text', {
                x: 1.5, y: 0.7, 'font-size': 1.6, fill: '#2e7d32', 'pointer-events': 'none',
                'data-plan-label': '1.6', 'data-plan-marker-label': '1', 'data-plan-min-zoom': '2.5',
            }, shortLabel(reader.name));
            dot.addEventListener('pointerdown', e => startDrag(e, (dx, dy) => {
                reader.x = Math.max(0, Math.min(100, reader.x + dx));
                reader.y = Math.max(0, Math.min(100, reader.y + dy));
            }));
            g.append(dot, label);
            devicesLayer.append(g);
        }

        layout.devices.forEach((device, index) => {
            const color = deviceColors[device.type] ?? '#555';
            const g = el('g', { cursor: 'move', 'data-plan-marker': `${device.x},${device.y}` });
            const icon = el('rect', {
                x: -1.1, y: -1.1, width: 2.2, height: 2.2,
                fill: color, stroke: '#fff', 'stroke-width': 0.25, transform: 'rotate(45)',
            });
            const mark = el('text', {
                y: 0.55, 'font-size': 1.3, fill: '#fff',
                'text-anchor': 'middle', 'pointer-events': 'none',
            }, deviceLabels[device.type] ?? '?');
            const label = el('text', {
                x: 2, y: 0.7, 'font-size': 1.6, fill: color, 'pointer-events': 'none',
                'data-plan-label': '1.6', 'data-plan-marker-label': '1', 'data-plan-min-zoom': '2',
            }, device.name);
            icon.addEventListener('pointerdown', e => startDrag(e, (dx, dy) => {
                device.x = Math.max(0, Math.min(100, device.x + dx));
                device.y = Math.max(0, Math.min(100, device.y + dy));
            }));
            icon.addEventListener('dblclick', () => {
                if (confirm(`Odebrat zařízení ${device.name}?`)) {
                    layout.devices.splice(index, 1);
                    dirty = true;
                    render();
                    renderUnplaced();
                }
            });
            g.append(icon, mark, label);
            devicesLayer.append(g);
        });

        plan.refresh();
    }

    // --- neumístěné prvky ---
    function renderUnplaced() {
        const host = document.getElementById('unplaced');
        host.replaceChildren();
        const unplaced = [
            ...layout.rooms.filter(r => r.x == null).map(r => ({ label: `místnost ${r.name}`, place: () => { r.x = 42; r.y = 42; r.w = 14; r.h = 10; } })),
            ...layout.readers.filter(r => r.x == null).map(r => ({ label: `čtečka ${r.name}`, place: () => { r.x = 50; r.y = 50; } })),
        ];
        if (unplaced.length === 0) return;
        const info = document.createElement('span');
        info.className = 'muted';
        info.textContent = 'Neumístěno: ';
        host.append(info);
        for (const u of unplaced) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-sm btn-ghost';
            btn.textContent = `+ ${u.label}`;
            btn.addEventListener('click', () => { u.place(); dirty = true; render(); renderUnplaced(); });
            host.append(btn, document.createTextNode(' '));
        }
    }

    // --- přidání zařízení ---
    document.getElementById('add-device').addEventListener('click', () => {
        const type = document.getElementById('device-type').value;
        const name = document.getElementById('device-name').value.trim() || type;
        layout.devices.push({ id: null, type, name, x: 50, y: 50 });
        document.getElementById('device-name').value = '';
        dirty = true;
        render();
    });

    // --- uložení ---
    document.getElementById('save-btn').addEventListener('click', async () => {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const info = document.getElementById('save-info');
        info.textContent = 'ukládám…';
        const response = await fetch(location.pathname + '?handler=SaveLayout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': token },
            body: JSON.stringify(layout),
        });
        info.textContent = response.ok ? 'uloženo ✓' : 'chyba uložení!';
        if (response.ok) dirty = false;
    });

    window.addEventListener('beforeunload', e => { if (dirty) e.preventDefault(); });

    const zoomInfo = document.getElementById('zoom-info');
    const plan = createPlanView(svg, content, {
        onChange: k => zoomInfo.textContent = k > 1.05 ? `přiblíženo ${k.toFixed(1)}×` : '',
    });

    document.getElementById('zoom-in').addEventListener('click', () => plan.zoomBy(1.5));
    document.getElementById('zoom-out').addEventListener('click', () => plan.zoomBy(1 / 1.5));
    document.getElementById('zoom-reset').addEventListener('click', () => plan.reset());
    window.addEventListener('resize', () => plan.refresh());

    render();
    renderUnplaced();
})();
</script>
}

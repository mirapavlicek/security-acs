@page
@model Acs.Web.Pages.Catalog.Matrices.IndexModel
@{
    ViewData["Title"] = "Schvalovací matice";
}
<h1>Schvalovací matice</h1>
<p class="muted">
    Matice definuje, kdo a v jakém pořadí schvaluje žádost. Jedna matice může sloužit více čtečkám i skupinám —
    hromadně se přiřazuje zaškrtnutím řádků v seznamu <a asp-page="/Catalog/Readers/Index">čteček</a>
    nebo <a asp-page="/Catalog/Groups/Index">skupin</a>.
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="card">
    <h2 style="margin-top:0">Výchozí matice</h2>
    <p class="muted" style="margin-top:0">
        Platí pro čtečky, skupiny a parkovací povolení (SPZ), které vlastní matici nemají.
        Bez výchozí matice takové žádosti rozhoduje administrátor.
    </p>
    @if (Model.DefaultMatrix is { } current)
    {
        <p>
            Teď: <strong>@current.Name</strong>
            <span class="muted">(@current.Levels.Count @(current.Levels.Count == 1 ? "úroveň" : "úrovně"))</span>
            <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@current.Id">Upravit</a>
        </p>
    }
    else
    {
        <p><strong>Není nastavena</strong> — položky bez matice rozhoduje administrátor.</p>
    }
    <form method="post" asp-page-handler="SetDefault" class="inline-form">
        <select name="matrixId" style="max-width:320px;display:inline-block">
            <option value="">— žádná (rozhoduje administrátor) —</option>
            @foreach (var matrix in Model.Matrices.Where(m => m.IsActive && m.Levels.Count > 0))
            {
                <option value="@matrix.Id" selected="@matrix.IsDefault">@matrix.Name</option>
            }
        </select>
        <button class="btn btn-sm" type="submit">Nastavit</button>
    </form>
    @if (Model.DefaultMatrix is null || Model.ManagerMatrix is null || !Model.ManagerMatrix.IsDefault)
    {
        <form method="post" asp-page-handler="CreateManagerDefault" class="inline-form" style="margin-top:0.6rem">
            <button class="btn btn-sm" type="submit">
                @(Model.ManagerMatrix is null ? "Založit matici „Nadřízený zaměstnance“ a nastavit jako výchozí" : $"Nastavit „{Model.ManagerMatrix.Name}“ jako výchozí")
            </button>
            <span class="hint">
                SPZ i karty pak schvalují nadřízení (z AD). Nadřízeného má @Model.EmployeesWithManager z @Model.EmployeesActive aktivních zaměstnanců;
                bez nadřízeného rozhodne administrátor.
            </span>
        </form>
    }
</div>

<div class="card">
    <h2 style="margin-top:0">Matice pro žádosti o kamery / EZS</h2>
    <p class="muted" style="margin-top:0">
        Žádosti o zřízení / rozšíření kamerového systému nebo EZS schvaluje tato matice; schválené jdou do
        fronty realizace ICT. Bez nastavení se použije výchozí matice, bez ní rozhoduje administrátor.
    </p>
    <form method="post" asp-page-handler="SetSecurity" class="inline-form">
        <select name="matrixId" style="max-width:320px;display:inline-block">
            <option value="">— výchozí matice / administrátor —</option>
            @foreach (var matrix in Model.Matrices.Where(m => m.IsActive && m.Levels.Count > 0))
            {
                <option value="@matrix.Id" selected="@(Model.SecurityMatrix?.Id == matrix.Id)">@matrix.Name</option>
            }
        </select>
        <button class="btn btn-sm" type="submit">Nastavit</button>
    </form>
</div>

<div class="card">
    <h2 style="margin-top:0">Založit matice podle schvalovací matice FN Motol</h2>
    <p class="muted" style="margin-top:0">
        Jedním klikem vznikne trojice matic podle dokumentu <em>Schvalovací matice – EKV, parkování, kamery, EZS</em>:
    </p>
    <ul class="muted" style="margin-top:0">
        <li><strong>EKV – vstupní oprávnění</strong> (nastaví se jako výchozí): řadový / vedoucí → nadřízený; mimo vlastní úsek
            navíc odpovědná osoba cílového úseku (jen řadový) a vedoucí OVBKŘ; přímo podřízený řediteli mimo svůj úsek → ředitel;
            ředitel a náměstek ve svém úseku → bez schvalování, rovnou realizace.</li>
        <li><strong>Parkování – vjezd</strong> (přiřadí se druhům povolení bez matice): řadový / vedoucí → nadřízený → úsek parkování;
            náměstek / ředitel → přímo úsek parkování.</li>
        <li><strong>Kamery / EZS</strong>: vedoucí OVBKŘ → realizace ICT; žádá-li vedoucí OVBKŘ sám, rozhoduje jeho nadřízený.</li>
    </ul>
    <p class="hint">
        Předpoklady: zaměstnanci mají nadřízené (z AD), kategorie se odvodí z hierarchie, prostory mají úsek nebo
        odpovědnou osobu (<a asp-page="/Catalog/OrgUnits/Index">Úseky</a>). Existující matice stejného názvu se nepřepisují.
    </p>
    <form method="post" asp-page-handler="CreateFnm" class="inline-form">
        <select name="ovbkrUserId" style="max-width:320px;display:inline-block">
            <option value="">— vedoucí OVBKŘ (doplnit později) —</option>
            @foreach (var user in Model.Users)
            {
                <option value="@user.Id">@(user.DisplayName ?? user.UserName)</option>
            }
        </select>
        <button class="btn btn-sm" type="submit">@(Model.FnmTemplateExists ? "Znovu použít / doplnit matice FN Motol" : "Založit matice FN Motol")</button>
    </form>
</div>

@if (Model.ReadersWithoutMatrix > 0 && Model.DefaultMatrix is null)
{
    <div class="alert alert-error">
        Bez matice je @Model.ReadersWithoutMatrix čteček — žádosti o ně smí schválit jen administrátor.
        <a asp-page="/Catalog/Readers/Index"
           asp-route-matrix="@Acs.Web.Pages.Catalog.Readers.IndexModel.NoMatrixFilter">Přiřadit jim matici hromadně</a>,
        nebo nastavte výchozí matici výše.
    </div>
}

<div class="card">
    <table class="data">
        <thead>
        <tr><th>Název</th><th>Úrovní</th><th>Používá čteček</th><th>Používá skupin</th><th>Aktivní</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var matrix in Model.Matrices)
        {
            <tr>
                <td>
                    @matrix.Name
                    @if (matrix.IsDefault)
                    {
                        <span class="badge badge-primary" title="Používá se pro položky bez vlastní matice">výchozí</span>
                    }
                    @if (Model.SecurityMatrix?.Id == matrix.Id)
                    {
                        <span class="badge badge-primary" title="Schvaluje žádosti o kamery / EZS">kamery / EZS</span>
                    }
                    @if (matrix.AutoApproveWhenNoLevels)
                    {
                        <span class="badge" title="Bez platné úrovně se položka schválí bez schvalovacího stupně">bez stupně</span>
                    }
                    <span class="muted">@matrix.Description</span>
                </td>
                <td>@matrix.Levels.Count</td>
                <td>
                    @Model.UsageCounts.GetValueOrDefault(matrix.Id)
                    <a asp-page="/Catalog/Readers/Index" asp-route-matrix="@matrix.Id">zobrazit</a>
                </td>
                <td>@Model.GroupUsageCounts.GetValueOrDefault(matrix.Id)</td>
                <td>@(matrix.IsActive ? "ano" : "ne")</td>
                <td><a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@matrix.Id">Upravit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="card" style="max-width:480px">
    <h2 style="margin-top:0">Nová matice</h2>
    <form method="post" asp-page-handler="Create">
        <input type="text" name="name" placeholder="Název matice" required />
        <button class="btn" type="submit">Vytvořit</button>
    </form>
</div>

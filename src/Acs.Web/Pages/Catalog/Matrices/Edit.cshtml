@page "{id:int}"
@using Acs.Domain.Entities
@model Acs.Web.Pages.Catalog.Matrices.EditModel
@{
    ViewData["Title"] = $"Matice: {Model.Matrix.Name}";
}
<h1>@ViewData["Title"]</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="card" style="max-width:640px">
    <form method="post" asp-page-handler="Rename">
        <label>Název</label>
        <input type="text" name="name" value="@Model.Matrix.Name" required />
        <label>Popis</label>
        <input type="text" name="description" value="@Model.Matrix.Description" />
        <div class="checkbox-row">
            <input type="checkbox" id="isActive" name="isActive" value="true" checked="@Model.Matrix.IsActive" />
            <label for="isActive">Aktivní</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" id="autoApprove" name="autoApprove" value="true" checked="@Model.Matrix.AutoApproveWhenNoLevels" />
            <label for="autoApprove">Bez platné úrovně schválit bez schvalovacího stupně (rovnou do fronty realizace)</label>
        </div>
        <p class="hint" style="margin-top:0">
            Když podmínky kategorie / úseku vyloučí všechny úrovně (např. ředitel, náměstek ve vlastním úseku),
            položka se schválí bez stupně. Nezaškrtnuto: takovou položku rozhoduje administrátor.
        </p>
        <div class="checkbox-row">
            <input type="checkbox" id="unknownAsOutside" name="unknownAsOutside" value="true" checked="@Model.Matrix.TreatUnknownUnitAsOutside" />
            <label for="unknownAsOutside">Prostor bez úseku a odpovědné osoby brát jako „mimo vlastní úsek“ (přísnější)</label>
        </div>
        <p class="hint" style="margin-top:0">
            Nezaškrtnuto: prostor, u kterého ACS nezná úsek ani odpovědnou osobu, se bere jako vlastní úsek
            zaměstnance (uplatní se jen úrovně bez podmínky a „jen vlastní úsek“).
        </p>
        <button class="btn" type="submit">Uložit</button>
        <a class="btn btn-ghost" asp-page="Index">Zpět na seznam</a>
    </form>
</div>

<h2>Úrovně schvalování (žádost jimi prochází postupně; hloubka není omezena)</h2>

@foreach (var level in Model.Matrix.Levels.OrderBy(l => l.Order))
{
    <div class="card" style="max-width:760px">
        <h3 style="margin-top:0">
            Úroveň @level.Order @(level.Name is null ? "" : $"— {level.Name}")
            @if (level.IsConditional)
            {
                <span class="badge" title="Úroveň platí jen za podmínky">
                    @level.AppliesToRanks.Label()@(level.Scope == LevelScope.Always ? "" : level.Scope == LevelScope.InsideOwnUnit ? " · jen vlastní úsek" : " · jen mimo vlastní úsek")
                </span>
            }
            <form method="post" asp-page-handler="RemoveLevel" class="inline-form" style="float:right">
                <input type="hidden" name="levelId" value="@level.Id" />
                <button class="btn btn-sm btn-danger" type="submit"
                        onclick="return confirm('Smazat úroveň @level.Order?')">Smazat úroveň</button>
            </form>
        </h3>

        <form method="post" asp-page-handler="UpdateLevel" class="inline-form">
            <input type="hidden" name="levelId" value="@level.Id" />
            <label>Název úrovně</label>
            <input type="text" name="name" value="@level.Name" placeholder="např. Nadřízený, Vedoucí OVBKŘ" style="max-width:320px" />
            <label>Režim schválení</label>
            <select name="mode">
                <option value="Any" selected="@(level.Mode == ApprovalMode.Any)">Stačí kterýkoli schvalovatel</option>
                <option value="All" selected="@(level.Mode == ApprovalMode.All)">Musí schválit všichni</option>
                <option value="Quorum" selected="@(level.Mode == ApprovalMode.Quorum)">Alespoň N schvalovatelů</option>
            </select>
            <label>N (jen pro režim „alespoň N“)</label>
            <input type="number" name="requiredCount" value="@level.RequiredCount" min="1" style="max-width:100px" />
            <label>Platí pro kategorie zaměstnance (nic zaškrtnuto = pro všechny)</label>
            <div class="checkbox-row" style="flex-wrap:wrap;gap:0.8rem">
                @foreach (var (flag, label) in new[] { (RankFlags.Staff, "řadový"), (RankFlags.Manager, "vedoucí"), (RankFlags.Executive, "přímo pod ředitelem"), (RankFlags.Director, "ředitel") })
                {
                    <label style="display:inline-flex;align-items:center;gap:0.3rem;margin:0">
                        <input type="checkbox" name="ranks" value="@flag" checked="@(level.AppliesToRanks != RankFlags.None && level.AppliesToRanks.HasFlag(flag))" /> @label
                    </label>
                }
            </div>
            <label>Vztah k prostoru žádosti</label>
            <select name="scope">
                <option value="Always" selected="@(level.Scope == LevelScope.Always)">Vždy (bez podmínky)</option>
                <option value="InsideOwnUnit" selected="@(level.Scope == LevelScope.InsideOwnUnit)">Jen vstup v rámci vlastního úseku</option>
                <option value="OutsideOwnUnit" selected="@(level.Scope == LevelScope.OutsideOwnUnit)">Jen vstup mimo vlastní úsek</option>
            </select>
            <p class="hint">
                Úroveň, která pro cílového zaměstnance a prostor neplatí, se přeskočí. Parkování a kamery / EZS
                prostor nemají — úrovně s podmínkou úseku se u nich neuplatní.
            </p>
            <button class="btn btn-sm" type="submit">Uložit úroveň</button>
        </form>

        <h4 style="margin-bottom:0.3rem">Schvalovatelé</h4>
        <table class="data">
            @foreach (var approver in level.Approvers)
            {
                <tr>
                    <td>
                        @if (approver.Kind == ApproverKind.LineManager)
                        {
                            <span class="badge">@(approver.ManagerDepth >= 2 ? "Nadřízený nadřízeného" : "Nadřízený zaměstnance")</span>
                            <span class="muted">z AD (atribut manager) — vyhodnotí se u každé žádosti podle cílového zaměstnance</span>
                        }
                        else if (approver.Kind == ApproverKind.AreaOwner)
                        {
                            <span class="badge">Odpovědná osoba cílového úseku</span>
                            <span class="muted">odpovědná osoba prostoru žádosti (čtečka → místnost → patro → budova, skupina), nebo vedoucí úseku, kterému prostor patří</span>
                        }
                        else if (approver.User is not null)
                        {
                            @(approver.User.DisplayName ?? approver.User.UserName)
                        }
                        else
                        {
                            <span class="badge">AD skupina</span> @approver.AdGroup
                        }
                    </td>
                    <td style="width:1%">
                        <form method="post" asp-page-handler="RemoveApprover" class="inline-form">
                            <input type="hidden" name="approverId" value="@approver.Id" />
                            <button class="btn btn-sm btn-ghost" type="submit">Odebrat</button>
                        </form>
                    </td>
                </tr>
            }
        </table>

        <form method="post" asp-page-handler="AddApprover" class="inline-form approver-add" style="display:block;margin-top:0.5rem">
            <input type="hidden" name="levelId" value="@level.Id" />
            <select name="kind" style="max-width:280px;display:inline-block" data-role="approver-kind">
                <option value="User">Konkrétní uživatel</option>
                <option value="Manager1">Nadřízený zaměstnance (z AD)</option>
                <option value="Manager2">Nadřízený nadřízeného</option>
                <option value="AreaOwner">Odpovědná osoba cílového úseku (vlastník prostoru)</option>
            </select>
            <select name="userId" style="max-width:280px;display:inline-block" data-role="approver-user">
                <option value="">— vyberte uživatele —</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.Id">@(user.DisplayName ?? user.UserName)</option>
                }
            </select>
            <button class="btn btn-sm" type="submit">Přidat schvalovatele</button>
        </form>
    </div>
}

<div class="card" style="max-width:760px">
    <h3 style="margin-top:0">Podmíněné úrovně a odpovědná osoba úseku</h3>
    <p class="muted" style="margin-bottom:0">
        Každá úroveň může platit jen pro některé kategorie zaměstnance (řadový / vedoucí / přímo pod ředitelem /
        ředitel — <a asp-page="/Catalog/Employees/Index">odvozují se z hierarchie</a>) a jen pro vstup v rámci
        vlastního, nebo mimo vlastní úsek. Vlastní úsek = prostor patří úseku zaměstnance (nebo nadřazenému /
        podřízenému), nebo je odpovědná osoba prostoru v linii jeho nadřízených (či naopak).
        Úseky a vlastníci prostorů: <a asp-page="/Catalog/OrgUnits/Index">Úseky</a>, editace čtečky,
        <a asp-page="/Catalog/Places">Budovy a místnosti</a>, skupiny čteček.
        Konkrétní uživatel, který by schvaloval sám sobě (je cílovým zaměstnancem), se nahradí svým nadřízeným.
    </p>
</div>

<div class="card" style="max-width:760px">
    <h3 style="margin-top:0">Schvalovatel „nadřízený zaměstnance“</h3>
    <p class="muted" style="margin-bottom:0">
        Vyhodnocuje se u každé žádosti podle nadřízeného cílového zaměstnance
        (z AD atributu <code>manager</code> při importu, nebo zadaného ručně u zaměstnance).
        Je-li nadřízený zároveň žadatelem, rozhoduje jeho nadřízený. Když zaměstnanec nadřízeného nemá,
        rozhodne na této úrovni administrátor a dostane upozornění.
        V ACS má teď nadřízeného <strong>@Model.EmployeesWithManager z @Model.EmployeesActive</strong> aktivních zaměstnanců
        (<a asp-page="/Catalog/Employees/Index" asp-route-withoutManager="true">bez nadřízeného</a>,
        <a asp-page="/Admin/Settings" asp-fragment="s-employees">nastavení atributu</a>).
    </p>
</div>

<div class="card" style="max-width:480px">
    <h2 style="margin-top:0">Přidat úroveň</h2>
    <form method="post" asp-page-handler="AddLevel">
        <input type="text" name="name" placeholder="Název úrovně (volitelné, např. Vedoucí oddělení)" />
        <button class="btn" type="submit">Přidat úroveň @(Model.Matrix.Levels.Count + 1)</button>
    </form>
</div>

@section Scripts {
<script>
    // Výběr uživatele má smysl jen pro typ „konkrétní uživatel“.
    document.querySelectorAll('form.approver-add').forEach(function (form) {
        var kind = form.querySelector('[data-role=approver-kind]');
        var user = form.querySelector('[data-role=approver-user]');
        function sync() { user.style.display = kind.value === 'User' ? '' : 'none'; }
        kind.addEventListener('change', sync);
        sync();
    });
</script>
}

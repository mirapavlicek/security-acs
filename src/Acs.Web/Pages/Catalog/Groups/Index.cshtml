@page
@model Acs.Web.Pages.Catalog.Groups.IndexModel
@{
    ViewData["Title"] = "Skupiny čteček";
}
<h1>Skupiny čteček</h1>
<p class="muted">Skupina může obsahovat čtečky i vnořené skupiny. Žádost o skupinu prochází maticí skupiny a poté maticemi všech nadřazených skupin (vnořené schvalování).</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<form method="post" id="bulk-form">
    <div class="card bulkbar">
        <strong>Hromadné přiřazení matice</strong>
        <select name="matrixId" id="bulk-matrix">
            <option value="">— bez vlastní matice —</option>
            @foreach (var matrix in Model.Matrices)
            {
                <option value="@matrix.Id">@matrix.Name</option>
            }
        </select>
        <button class="btn btn-sm" type="submit" asp-page-handler="Assign" id="bulk-assign" disabled>
            Přiřadit označeným (<span id="bulk-count">0</span>)
        </button>
    </div>

    <div class="card">
        <table class="data">
            <thead>
            <tr>
                <th style="width:1%"><input type="checkbox" id="check-all" title="Označit vše" /></th>
                <th>Název</th><th>Matice</th><th>Čteček (rekurzivně)</th><th>Aktivní</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <td><input type="checkbox" name="groupIds" value="@group.Id" class="row-check" /></td>
                    <td>@group.Name <span class="muted">@group.Description</span></td>
                    <td>@(group.ApprovalMatrix?.Name ?? "— (schvaluje admin)")</td>
                    <td>@Model.ReaderCounts.GetValueOrDefault(group.Id)</td>
                    <td>@(group.IsActive ? "ano" : "ne")</td>
                    <td><a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@group.Id">Upravit</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Groups.Count == 0)
        {
            <p class="muted">Zatím žádné skupiny.</p>
        }
    </div>
</form>

<div class="card" style="max-width:480px">
    <h2 style="margin-top:0">Nová skupina</h2>
    <form method="post" asp-page-handler="Create">
        <input type="text" name="name" placeholder="Název skupiny (např. Chirurgie)" required />
        <button class="btn" type="submit">Vytvořit</button>
    </form>
</div>

@section Scripts {
    <script src="~/js/bulk-select.js" asp-append-version="true"></script>
}

@model Acs.Web.Pages.Catalog.BuildingContent
@{
    var building = Model.Building;
}

<h4 style="margin:0.4rem 0 0.2rem">Části budovy</h4>
@if (Model.Sections.Count > 0)
{
    <table class="data" style="margin-bottom:0.4rem">
        @foreach (var sec in Model.Sections)
        {
            var floorCount = Model.Floors.Count(f => f.SectionId == sec.Id);
            <tr>
                <td>@sec.Name <span class="muted">(pater: @floorCount)</span></td>
                <td style="width:1%">
                    <form method="post" asp-page="/Catalog/Places" asp-page-handler="DeleteSection" class="inline-form">
                        <input type="hidden" name="sectionId" value="@sec.Id" />
                        <button class="btn btn-sm btn-ghost" type="submit">Smazat</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
<form method="post" asp-page="/Catalog/Places" asp-page-handler="AddSection" class="inline-form">
    <input type="hidden" name="buildingId" value="@building.Id" />
    <input type="text" name="name" placeholder="Nová část (např. G)…" required style="max-width:180px;display:inline-block" />
    <button class="btn btn-sm" type="submit">Přidat část</button>
</form>

<h4 style="margin:0.8rem 0 0.2rem">Plány pater</h4>
<p class="hint" style="margin-top:0">
    Sestaví plány všech pater z dat — z poloh v projektových výkresech, a kde nejsou,
    jako schéma podle chodeb. Hodí se hned po importu z DPS, ať se místnosti nemusí
    do plánu přetahovat ručně.
</p>
<form method="post" asp-page="/Catalog/Places" asp-page-handler="GeneratePlans" class="inline-form">
    <input type="hidden" name="buildingId" value="@building.Id" />
    <button class="btn btn-sm" type="submit" name="onlyEmpty" value="true">Generuj chybějící plány</button>
    <button class="btn btn-sm btn-ghost" type="submit" name="onlyEmpty" value="false"
            onclick="return confirm('Přerovnat plány všech pater budovy @building.Name? Ruční úpravy pozic se přepíší.')">
        Generuj všechny znovu
    </button>
</form>

<h4 style="margin:0.8rem 0 0.2rem">Patra</h4>
@if (Model.Floors.Count == 0)
{
    <p class="muted">Budova zatím nemá žádná patra.</p>
}
@foreach (var floor in Model.Floors)
{
    var counts = Model.FloorCounts.GetValueOrDefault(floor.Id);
    <details class="tree-node tree-floor" data-load="?handler=Floor&amp;id=@floor.Id" id="floor-@floor.Id">
        <summary>
            <strong>Patro @floor.Name</strong>
            @if (floor.Section is not null)
            {
                <span class="badge">část @floor.Section.Name</span>
            }
            <span class="muted">
                — chodeb @counts.Corridors, místností @counts.Rooms, čteček @counts.Readers
            </span>
        </summary>
        <div class="tree-body"><p class="muted">Načítám…</p></div>
    </details>
}

<form method="post" asp-page="/Catalog/Places" asp-page-handler="AddFloor" class="inline-form" style="display:block;margin-top:0.8rem">
    <input type="hidden" name="buildingId" value="@building.Id" />
    <input type="text" name="name" placeholder="Nové patro (např. -1, P)…" required style="max-width:160px;display:inline-block" />
    <select name="sectionId" style="max-width:150px;display:inline-block">
        <option value="">— část —</option>
        @foreach (var sec in Model.Sections)
        {
            <option value="@sec.Id">@sec.Name</option>
        }
    </select>
    <button class="btn btn-sm" type="submit">Přidat patro</button>
</form>

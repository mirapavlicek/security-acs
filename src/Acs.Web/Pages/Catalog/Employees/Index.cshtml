@page
@using Acs.Domain.Entities
@model Acs.Web.Pages.Catalog.Employees.IndexModel
@{
    ViewData["Title"] = "Zaměstnanci";
    var running = Model.EmployeeJobStatus?.Running == true || Model.CardJobStatus?.Running == true;

    string TypeShort(IdentifierType t) => t switch
    {
        IdentifierType.Card => "karta",
        IdentifierType.LicensePlate => "SPZ",
        IdentifierType.Pin => "PIN",
        IdentifierType.Tag => "čip",
        IdentifierType.Biometric => "bio",
        _ => "jiný",
    };
}
@if (running)
{
    <meta http-equiv="refresh" content="10" />
}
<h1>Zaměstnanci</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@foreach (var job in new[] { Model.EmployeeJobStatus, Model.CardJobStatus })
{
    if (job is null) { continue; }
    <div class="alert @(job.Error is not null ? "alert-error" : "alert-success")">
        <strong>@job.Name</strong>
        @if (job.Running)
        {
            <span> — probíhá @((int)job.Duration.TotalSeconds) s… (stránka se sama obnovuje)</span>
        }
        else if (job.Error is not null)
        {
            <span> — selhalo po @((int)job.Duration.TotalSeconds) s: @job.Error</span>
        }
        else
        {
            <span> — dokončeno za @((int)job.Duration.TotalSeconds) s: @job.Result</span>
        }
    </div>
}

<div class="card">
    <form method="get" class="inline-form">
        <input type="text" name="search" value="@Model.Search"
               placeholder="Jméno, oddělení, osobní číslo, karta, SPZ…"
               style="max-width:340px;display:inline-block" />
        <label style="display:inline-block;margin:0 0.5rem">
            <input type="checkbox" name="withoutManager" value="true" checked="@Model.WithoutManager" /> bez nadřízeného
        </label>
        <label style="display:inline-block;margin:0 0.5rem">
            <input type="checkbox" name="withoutUnit" value="true" checked="@Model.WithoutUnit" /> bez úseku
        </label>
        <select name="rank" style="max-width:220px;display:inline-block;margin:0 0.5rem 0 0">
            <option value="">— všechny kategorie —</option>
            <option value="@EmployeeRank.Staff" selected="@(Model.Rank == EmployeeRank.Staff)">řadový zaměstnanec</option>
            <option value="@EmployeeRank.Manager" selected="@(Model.Rank == EmployeeRank.Manager)">vedoucí zaměstnanec</option>
            <option value="@EmployeeRank.Executive" selected="@(Model.Rank == EmployeeRank.Executive)">přímo podřízený řediteli</option>
            <option value="@EmployeeRank.Director" selected="@(Model.Rank == EmployeeRank.Director)">ředitel</option>
        </select>
        <button class="btn btn-sm" type="submit">Hledat</button>
    </form>
    <form method="post" asp-page-handler="Sync" class="inline-form" style="float:right">
        <button class="btn btn-sm" type="submit" disabled="@(Model.EmployeeJobStatus?.Running == true)">
            Importovat z AD
        </button>
    </form>
    <form method="post" asp-page-handler="SyncCards" class="inline-form" style="float:right;margin-right:0.5rem">
        <button class="btn btn-sm btn-ghost" type="submit" disabled="@(Model.CardJobStatus?.Running == true)">
            Synchronizovat karty (SQL)
        </button>
    </form>
    <a class="btn btn-sm btn-ghost" style="float:right;margin-right:0.5rem" asp-page="Edit">+ Nový zaměstnanec</a>
</div>

<div class="card">
    <p class="muted" style="margin-top:0">
        Nalezeno @Model.TotalCount zaměstnanců@(Model.TotalCount > Model.Employees.Count ? $", zobrazeno prvních {Model.Employees.Count}" : "").
        Nadřízeného má @Model.WithManagerCount z @Model.ActiveCount aktivních
        <span title="Nadřízený se načítá z AD atributu manager při importu; lze ho zadat i ručně. Používá se ve schvalovacích maticích.">ⓘ</span>,
        úsek @Model.WithUnitCount (<a asp-page="/Catalog/OrgUnits/Index">úseky a mapování oddělení</a>).
    </p>
    <table class="data">
        <thead>
        <tr><th>Jméno</th><th>Os. číslo</th><th>Oddělení</th><th>Úsek</th><th>Kategorie</th><th>Nadřízený</th><th>AD účet</th><th>Identifikátory</th><th>Zdroj</th><th>Aktivní</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.FullName</td>
                <td class="muted">@employee.PersonalNumber</td>
                <td>@employee.Department</td>
                <td>
                    @if (employee.OrgUnit is { } unit)
                    {
                        <a asp-page="/Catalog/OrgUnits/Edit" asp-route-id="@unit.Id">@unit.DisplayName</a>
                        @if (employee.OrgUnitManual)
                        {
                            <span class="badge" title="Zadáno ručně — přepočet z oddělení nepřepisuje">ručně</span>
                        }
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </td>
                <td>
                    <span class="muted">@employee.EffectiveRank.Label()</span>
                    @if (employee.RankManual)
                    {
                        <span class="badge" title="Zadáno ručně — odvození z hierarchie nepřepisuje">ručně</span>
                    }
                </td>
                <td>
                    @if (employee.Manager is { } manager)
                    {
                        <a asp-page="Edit" asp-route-id="@manager.Id">@manager.FullName</a>
                        @if (employee.ManagerManual)
                        {
                            <span class="badge" title="Zadáno ručně — import z AD nepřepisuje">ručně</span>
                        }
                    }
                    else if (employee.ManagerAdAccount is not null)
                    {
                        <span class="muted" title="Zdroj nadřízeného uvádí, ale v ACS se nenašel: @employee.ManagerAdAccount">nespárováno</span>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </td>
                <td class="muted">@employee.AdAccount</td>
                <td class="muted">
                    @if (Model.Identifiers.TryGetValue(employee.Id, out var ids) && ids.Count > 0)
                    {
                        @string.Join(", ", ids.Select(i => $"{TypeShort(i.Type)} {i.Value}"))
                    }
                    else if (employee.CardNumber is not null)
                    {
                        @($"karta {employee.CardNumber}")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td><span class="badge">@(employee.Source == RecordSource.Imported ? "import" : "ruční")</span></td>
                <td>@(employee.IsActive ? "ano" : "ne")</td>
                <td><a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@employee.Id">Upravit</a></td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Employees.Count == 0)
    {
        <p class="muted">Žádní zaměstnanci. Nakonfigurujte zdroj v Nastavení a spusťte import, nebo přidejte ručně.</p>
    }
</div>

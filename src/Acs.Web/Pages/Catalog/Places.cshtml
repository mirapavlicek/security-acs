@page
@model Acs.Web.Pages.Catalog.PlacesModel
@{
    ViewData["Title"] = "Budovy a místnosti";
}
<h1>Budovy — části, patra, chodby a místnosti</h1>
<p class="muted">
    Hierarchie: budova (MOC) → část (G) → patro (-1, P) → chodba (A100) → místnost (M1000).
    Obsah se načítá až po rozbalení, aby se velké budovy otevíraly rychle.
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@if (User.IsInRole("Admin"))
{
    <p class="muted">
        Hromadné naplnění z projektových výkresů: <a asp-page="/Admin/ImportPlan">Import z DPS plánů</a>.
    </p>
}

@foreach (var summary in Model.Buildings)
{
    <details class="card tree-node" data-load="?handler=Building&id=@summary.Building.Id"
             id="building-@summary.Building.Id">
        <summary>
            <strong>@summary.Building.Name</strong>
            <span class="muted">
                — částí @summary.Sections, pater @summary.Floors,
                chodeb @summary.Corridors, místností @summary.Rooms, čteček @summary.Readers
            </span>
            <form method="post" asp-page-handler="DeleteBuilding" class="inline-form" style="float:right">
                <input type="hidden" name="buildingId" value="@summary.Building.Id" />
                <button class="btn btn-sm btn-danger" type="submit"
                        onclick="return confirm('Smazat budovu @summary.Building.Name včetně částí, pater, chodeb a místností?')">
                    Smazat budovu
                </button>
            </form>
        </summary>
        <div class="tree-body"><p class="muted">Načítám…</p></div>
    </details>
}

@if (Model.Buildings.Count == 0)
{
    <div class="card"><p class="muted">Zatím žádné budovy.</p></div>
}

<div class="card" style="max-width:480px">
    <h2 style="margin-top:0">Nová budova</h2>
    <form method="post" asp-page-handler="AddBuilding">
        <input type="text" name="name" placeholder="Název budovy (např. MOC)" required />
        <button class="btn" type="submit">Přidat budovu</button>
    </form>
</div>

@section Scripts {
<script>
(() => {
    // Obsah uzlu se stáhne až při prvním rozbalení (lazy load).
    async function load(node) {
        if (node.dataset.loaded === '1') return;
        node.dataset.loaded = '1';
        const body = node.querySelector(':scope > .tree-body');
        try {
            const response = await fetch(node.dataset.load, { headers: { 'X-Requested-With': 'fetch' } });
            if (!response.ok) throw new Error(response.status);
            body.innerHTML = await response.text();
            bind(body);
        } catch (e) {
            node.dataset.loaded = '';
            body.innerHTML = '<p class="alert alert-error">Načtení se nezdařilo, zkuste to znovu.</p>';
        }
    }

    function bind(root) {
        for (const node of root.querySelectorAll('details.tree-node[data-load]')) {
            if (node.dataset.bound === '1') continue;
            node.dataset.bound = '1';
            node.addEventListener('toggle', () => { if (node.open) load(node); });
        }
        for (const box of root.querySelectorAll('input[data-filter]')) {
            if (box.dataset.bound === '1') continue;
            box.dataset.bound = '1';
            box.addEventListener('input', () => {
                const table = document.getElementById(box.dataset.filter);
                if (!table) return;
                const needle = box.value.trim().toLowerCase();
                for (const row of table.rows) {
                    row.hidden = needle !== '' && !row.cells[0].textContent.toLowerCase().includes(needle);
                }
            });
        }
    }

    bind(document);

    // Po uložení formuláře se znovu otevře uzel, se kterým se pracovalo.
    const params = new URLSearchParams(location.search);
    const open = params.get('open');
    const parent = params.get('parent');

    function reveal(id) {
        const target = document.getElementById(id);
        if (!target) return false;
        target.open = true;
        target.scrollIntoView({ block: 'center' });
        return true;
    }

    if (open && !reveal(open) && parent) {
        // Cílový uzel je uvnitř nadřazeného, který se teprve dotahuje.
        const observer = new MutationObserver(() => {
            if (reveal(open)) observer.disconnect();
        });
        observer.observe(document.body, { childList: true, subtree: true });
        reveal(parent);
    }
})();
</script>
}

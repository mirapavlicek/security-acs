@page
@model Acs.Web.Pages.Catalog.PlacesModel
@{
    ViewData["Title"] = "Budovy a místnosti";
}
<h1>Budovy — části, patra, chodby a místnosti</h1>
<p class="muted">
    Hierarchie: budova (MOC) → část (G) → patro (-1, P) → chodba (A100) → místnost (M1000).
    Chodby se mohou řetězit (chodba → nadřazená chodba); žádost o čtečku místnosti pak
    automaticky přidá čtečky celého řetězu chodeb.
</p>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@foreach (var building in Model.Buildings)
{
    <div class="card">
        <h2 style="margin-top:0">@building.Name
            <form method="post" asp-page-handler="DeleteBuilding" class="inline-form" style="float:right">
                <input type="hidden" name="buildingId" value="@building.Id" />
                <button class="btn btn-sm btn-danger" type="submit"
                        onclick="return confirm('Smazat budovu @building.Name včetně částí, pater, chodeb a místností?')">Smazat budovu</button>
            </form>
        </h2>

        <h4 style="margin:0.4rem 0 0.2rem">Části budovy</h4>
        @if (building.Sections.Count > 0)
        {
            <table class="data" style="margin-bottom:0.4rem">
                @foreach (var sec in building.Sections.OrderBy(s => s.SortOrder))
                {
                    <tr>
                        <td>@sec.Name <span class="muted">(pater: @sec.Floors.Count)</span></td>
                        <td style="width:1%">
                            <form method="post" asp-page-handler="DeleteSection" class="inline-form">
                                <input type="hidden" name="sectionId" value="@sec.Id" />
                                <button class="btn btn-sm btn-ghost" type="submit">Smazat</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        }
        <form method="post" asp-page-handler="AddSection" class="inline-form">
            <input type="hidden" name="buildingId" value="@building.Id" />
            <input type="text" name="name" placeholder="Nová část (např. G)…" required style="max-width:180px;display:inline-block" />
            <button class="btn btn-sm" type="submit">Přidat část</button>
        </form>

        @foreach (var floor in building.Floors.OrderBy(f => f.SortOrder))
        {
            <h3 style="margin:1rem 0 0.3rem">
                Patro @floor.Name
                @if (floor.Section is not null)
                {
                    <span class="badge">část @floor.Section.Name</span>
                }
                <form method="post" asp-page-handler="DeleteFloor" class="inline-form">
                    <input type="hidden" name="floorId" value="@floor.Id" />
                    <button class="btn btn-sm btn-ghost" type="submit"
                            onclick="return confirm('Smazat patro @floor.Name?')">Smazat patro</button>
                </form>
                <a class="btn btn-sm btn-ghost" asp-page="FloorPlan" asp-route-id="@floor.Id">Editor plánu</a>
            </h3>

            <h4 style="margin:0.4rem 0 0.2rem">Chodby</h4>
            @if (floor.Corridors.Count > 0)
            {
                <table class="data" style="margin-bottom:0.4rem">
                    @foreach (var corridor in floor.Corridors.OrderBy(c => c.Name))
                    {
                        <tr>
                            <td>@corridor.Name</td>
                            <td class="muted">
                                @(corridor.ParentCorridor is null ? "bez nadřazené" : $"→ {corridor.ParentCorridor.Name}")
                                · čteček: @corridor.Readers.Count · místností: @corridor.Rooms.Count
                            </td>
                            <td style="width:1%">
                                <form method="post" asp-page-handler="SetCorridorParent" class="inline-form">
                                    <input type="hidden" name="corridorId" value="@corridor.Id" />
                                    <select name="parentCorridorId" style="max-width:170px;display:inline-block">
                                        <option value="">— nadřazená chodba —</option>
                                        @foreach (var candidate in Model.AllCorridors.Where(c => c.Id != corridor.Id))
                                        {
                                            <option value="@candidate.Id" selected="@(candidate.Id == corridor.ParentCorridorId)">
                                                @candidate.Name (@candidate.Floor?.Building?.Name/@candidate.Floor?.Name)
                                            </option>
                                        }
                                    </select>
                                    <button class="btn btn-sm" type="submit">Uložit</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteCorridor" class="inline-form">
                                    <input type="hidden" name="corridorId" value="@corridor.Id" />
                                    <button class="btn btn-sm btn-ghost" type="submit">Smazat</button>
                                </form>
                            </td>
                        </tr>
                    }
                </table>
            }
            <form method="post" asp-page-handler="AddCorridor" class="inline-form">
                <input type="hidden" name="floorId" value="@floor.Id" />
                <input type="text" name="name" placeholder="Nová chodba (např. A100)…" required style="max-width:180px;display:inline-block" />
                <button class="btn btn-sm" type="submit">Přidat chodbu</button>
            </form>

            <h4 style="margin:0.6rem 0 0.2rem">Místnosti</h4>
            <table class="data" style="margin-bottom:0.4rem">
                @foreach (var room in floor.Rooms.OrderBy(r => r.Name))
                {
                    <tr>
                        <td>@room.Name <span class="muted">@room.Description</span></td>
                        <td class="muted">čteček: @room.Readers.Count</td>
                        <td>
                            <form method="post" asp-page-handler="SetRoomCorridor" class="inline-form">
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <select name="corridorId" style="max-width:170px;display:inline-block">
                                    <option value="">— chodba —</option>
                                    @foreach (var corridor in floor.Corridors.OrderBy(c => c.Name))
                                    {
                                        <option value="@corridor.Id" selected="@(corridor.Id == room.CorridorId)">@corridor.Name</option>
                                    }
                                </select>
                                <button class="btn btn-sm" type="submit">Uložit</button>
                            </form>
                        </td>
                        <td style="width:1%">
                            <form method="post" asp-page-handler="DeleteRoom" class="inline-form">
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <button class="btn btn-sm btn-ghost" type="submit"
                                        onclick="return confirm('Smazat místnost @room.Name?')">Smazat</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
            <form method="post" asp-page-handler="AddRoom" class="inline-form">
                <input type="hidden" name="floorId" value="@floor.Id" />
                <input type="text" name="name" placeholder="Nová místnost (např. M1000)…" required style="max-width:180px;display:inline-block" />
                <select name="corridorId" style="max-width:150px;display:inline-block">
                    <option value="">— chodba —</option>
                    @foreach (var corridor in floor.Corridors.OrderBy(c => c.Name))
                    {
                        <option value="@corridor.Id">@corridor.Name</option>
                    }
                </select>
                <button class="btn btn-sm" type="submit">Přidat místnost</button>
            </form>
            <form method="post" asp-page-handler="UploadSchema" enctype="multipart/form-data" class="inline-form" style="margin-left:1rem">
                <input type="hidden" name="floorId" value="@floor.Id" />
                <input type="file" name="file" accept="image/png,image/jpeg,image/svg+xml" style="display:inline-block;max-width:230px" />
                <button class="btn btn-sm btn-ghost" type="submit">Nahrát schéma</button>
            </form>
        }

        <form method="post" asp-page-handler="AddFloor" class="inline-form" style="display:block;margin-top:0.8rem">
            <input type="hidden" name="buildingId" value="@building.Id" />
            <input type="text" name="name" placeholder="Nové patro (např. -1, P)…" required style="max-width:160px;display:inline-block" />
            <select name="sectionId" style="max-width:150px;display:inline-block">
                <option value="">— část —</option>
                @foreach (var sec in building.Sections.OrderBy(s => s.SortOrder))
                {
                    <option value="@sec.Id">@sec.Name</option>
                }
            </select>
            <button class="btn btn-sm" type="submit">Přidat patro</button>
        </form>
    </div>
}

<div class="card" style="max-width:480px">
    <h2 style="margin-top:0">Nová budova</h2>
    <form method="post" asp-page-handler="AddBuilding">
        <input type="text" name="name" placeholder="Název budovy (např. MOC)" required />
        <button class="btn" type="submit">Přidat budovu</button>
    </form>
</div>

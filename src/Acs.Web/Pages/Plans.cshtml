@page "{floorId:int?}"
@model Acs.Web.Pages.PlansModel
@{
    ViewData["Title"] = "Plány budov";
}
<h1>Plány budov</h1>

<div class="card">
    <form method="get">
        <label>Patro</label>
        <select name="floorId" onchange="this.form.submit()" style="max-width:400px">
            <option value="">— vyberte patro —</option>
            @foreach (var floor in Model.FloorsWithSchema)
            {
                <option value="@floor.Id" selected="@(floor.Id == Model.SelectedFloor?.Id)">
                    @floor.Building?.Name @(floor.Section is null ? "" : $"/ {floor.Section.Name}") / @floor.Name
                </option>
            }
        </select>
    </form>

    @if (Model.FloorsWithSchema.Count == 0)
    {
        <p class="muted">Zatím nejsou žádné plány (sestavuje správce číselníků v Budovách → Editor plánu).</p>
    }
</div>

@if (Model.SelectedFloor is not null)
{
    <div class="card">
        <p style="margin-top:0">
            <span style="color:#2e7d32">■ ●</span> máte přístup&nbsp;&nbsp;
            <span class="muted">■ ●</span> bez přístupu&nbsp;&nbsp;
            <span style="color:#b26a00">◆</span> kamera&nbsp;
            <span style="color:#c62828">◆</span> EZS&nbsp;
            <span style="color:#6a3cb5">◆</span> rozhlas&nbsp;
            <span style="color:#00695c">◆</span> TV
        </p>
        <div style="margin-bottom:0.4rem">
            <button class="btn btn-sm btn-ghost" type="button" id="zoom-in" title="Přiblížit">+</button>
            <button class="btn btn-sm btn-ghost" type="button" id="zoom-out" title="Oddálit">−</button>
            <button class="btn btn-sm btn-ghost" type="button" id="zoom-reset">Celé patro</button>
            <span class="muted" id="zoom-info"></span>
        </div>
        <div style="border:1px solid var(--border);background:var(--surface)">
            <svg id="plan-view" viewBox="0 0 100 100" preserveAspectRatio="none"
                 style="display:block;width:100%;aspect-ratio:4/3;touch-action:none;cursor:grab">
                <g id="view-content">
                    @if (Model.HasUnderlay)
                    {
                        <image href="/floors/@Model.SelectedFloor.Id/schema" x="0" y="0" width="100" height="100"
                               preserveAspectRatio="none" opacity="0.45" data-plan-background="1" />
                    }
                </g>
            </svg>
        </div>
        <p class="hint" style="margin-bottom:0">
            Kolečkem myši přiblížíte, tažením posunete. Popisky se dopisují podle přiblížení —
            celý název místnosti i čtečky se zobrazí po najetí myší.
        </p>
    </div>

    @section Scripts {
    <script src="~/js/plan-view.js"></script>
    <script>
    (() => {
        const layout = @Html.Raw(Model.LayoutJson);
        const svg = document.getElementById('plan-view');
        const host = document.getElementById('view-content');
        const NS = 'http://www.w3.org/2000/svg';
        const deviceColors = { Camera: '#b26a00', Ezs: '#c62828', Rozhlas: '#6a3cb5', Tv: '#00695c' };
        const deviceLabels = { Camera: 'K', Ezs: 'E', Rozhlas: 'R', Tv: 'TV' };

        function el(tag, attrs, text) {
            const e = document.createElementNS(NS, tag);
            for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
            if (text) e.textContent = text;
            return e;
        }

        for (const room of layout.rooms) {
            const w = room.w ?? 12, h = room.h ?? 9;
            // Místnost, kam má uživatel přístup, je zelená — na celé patro je tak
            // vidět, kam smí, i když jsou popisky při oddálení skryté.
            const rect = el('rect', { x: room.x, y: room.y, width: w, height: h,
                fill: room.mine ? 'rgba(46,125,50,0.22)' : 'rgba(11,107,203,0.10)',
                stroke: room.mine ? '#2e7d32' : '#0b6bcb', 'stroke-width': 0.3,
                rx: Math.min(0.6, w * 0.12, h * 0.12), 'vector-effect': 'non-scaling-stroke' });
            rect.append(el('title', {}, room.name + (room.mine ? ' — máte přístup' : '')));
            host.append(rect);

            // Popisek se vejde do obdélníku; jestli je čitelný, rozhodne přiblížení.
            const text = planShortLabel(room.name);
            const size = Math.min(h * 0.5, w / Math.max(text.length, 1) * 1.4);
            host.append(el('text', {
                x: room.x + w / 2, y: room.y + h / 2 + size * 0.35,
                'font-size': size.toFixed(2), fill: room.mine ? '#2e7d32' : '#0b6bcb', 'text-anchor': 'middle',
                'pointer-events': 'none', 'data-plan-label': size.toFixed(2),
            }, text));
        }

        for (const reader of layout.readers) {
            const color = reader.mine ? '#2e7d32' : '#8a97a5';
            const marker = el('g', { 'data-plan-marker': `${reader.x},${reader.y}` });
            const dot = el('circle', { r: 1.1, fill: color, stroke: '#fff', 'stroke-width': 0.25 });
            dot.append(el('title', {}, reader.name + (reader.mine ? ' — máte přístup' : '')));
            marker.append(dot, el('text', {
                x: 1.5, y: 0.7, 'font-size': 1.6, fill: color, 'pointer-events': 'none',
                'data-plan-label': '1.6', 'data-plan-marker-label': '1', 'data-plan-min-zoom': '2.5',
            }, planShortLabel(reader.name)));
            host.append(marker);
        }

        for (const device of layout.devices) {
            const color = deviceColors[device.type] ?? '#555';
            const marker = el('g', { 'data-plan-marker': `${device.x},${device.y}` });
            marker.append(
                el('rect', { x: -1.1, y: -1.1, width: 2.2, height: 2.2, fill: color,
                    stroke: '#fff', 'stroke-width': 0.25, transform: 'rotate(45)' }),
                el('text', { y: 0.55, 'font-size': 1.3, fill: '#fff', 'text-anchor': 'middle',
                    'pointer-events': 'none' }, deviceLabels[device.type] ?? '?'),
                el('text', { x: 2, y: 0.7, 'font-size': 1.6, fill: color, 'pointer-events': 'none',
                    'data-plan-label': '1.6', 'data-plan-marker-label': '1', 'data-plan-min-zoom': '2' },
                    device.name));
            marker.firstChild.append(el('title', {}, device.name));
            host.append(marker);
        }

        const info = document.getElementById('zoom-info');
        const plan = createPlanView(svg, host, {
            onChange: k => info.textContent = k > 1.05 ? `přiblíženo ${k.toFixed(1)}×` : '',
        });
        plan.refresh();

        document.getElementById('zoom-in').addEventListener('click', () => plan.zoomBy(1.5));
        document.getElementById('zoom-out').addEventListener('click', () => plan.zoomBy(1 / 1.5));
        document.getElementById('zoom-reset').addEventListener('click', () => plan.reset());
        window.addEventListener('resize', () => plan.refresh());
    })();
    </script>
    }
}

@page "{id:int}"
@using Acs.Domain.Entities
@using Acs.Web.Pages.Shared
@model Acs.Web.Pages.Requests.DetailModel
@{
    ViewData["Title"] = $"Žádost #{Model.Request.Id}" + (Model.Request.Kind == RequestKind.Revoke ? " (odebrání)" : "");
}
<h1>@ViewData["Title"]</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="card">
    <table class="data">
        <tr><td>Pro zaměstnance</td><td>@Model.Request.TargetEmployee?.FullName (@Model.Request.TargetEmployee?.Department)</td></tr>
        <tr><td>Podal</td><td>@(Model.Request.RequesterUser?.DisplayName ?? Model.Request.RequesterUser?.UserName)</td></tr>
        <tr><td>Podáno</td><td>@Model.Request.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td></tr>
        <tr><td>Zdůvodnění</td><td>@Model.Request.Justification</td></tr>
    </table>
</div>

@foreach (var item in Model.Request.Items)
{
    <div class="card">
        <h2 style="margin-top:0">
            @StatusText.ItemTitle(item)
            @if (item.Stages.Count > 1)
            {
                <span class="badge" title="Vnořené schvalování — položka prochází více maticemi">
                    fáze @item.CurrentStageOrder/@item.Stages.Count
                </span>
            }
            @if (item.AutoAdded)
            {
                <span class="badge" title="Doplněno automaticky z řetězce čteček">řetězec</span>
            }
            <span class="badge badge-primary">@StatusText.Label(item)</span>
            @if (item.Status == RequestStatus.Pending)
            {
                <span class="muted" style="font-size:0.85rem">— úroveň @item.CurrentLevelOrder</span>
            }
        </h2>

        @if (item.Status == RequestStatus.Pending && Model.Resolutions.TryGetValue(item.Id, out var resolution))
        {
            <p class="muted" style="margin-top:0">
                @if (resolution.RequiresAdminFallback)
                {
                    <span class="badge badge-danger" title="Úroveň nemá po vyhodnocení žádného schvalovatele">rozhodne správce</span>
                    <span>@(resolution.Warnings.Count > 0 ? string.Join("; ", resolution.Warnings) : "úroveň bez schvalovatele")</span>
                }
                else
                {
                    <span>Čeká na:</span>
                    @foreach (var approver in resolution.Approvers)
                    {
                        <span class="badge" title="@approver.OriginLabel">
                            @if (approver.Origin == Acs.Infrastructure.Workflow.ApproverOrigin.LineManager)
                            {
                                <text>@(approver.ManagerDepth >= 2 ? "Nadřízený nadřízeného" : "Nadřízený"): </text>
                            }
                            @approver.DisplayName
                        </span>
                    }
                    @if (resolution.Level.Mode != ApprovalMode.Any && resolution.Approvers.Count > 1)
                    {
                        <span>(@(resolution.Level.Mode == ApprovalMode.All ? "musí schválit všichni" : $"alespoň {resolution.Level.RequiredCount ?? 1}"))</span>
                    }
                    @foreach (var warning in resolution.Warnings)
                    {
                        <br /><span class="hint">@warning</span>
                    }
                }
            </p>
        }

        @if (item.ParkingPermit is { } permit)
        {
            <table class="data" style="margin-bottom:0.6rem">
                <tr><td>Druh povolení</td><td>@permit.PermitType?.Name <span class="muted">@permit.PermitType?.Description</span></td></tr>
                <tr><td>@(permit.PermitType?.Binding == PermitBinding.Function ? "Funkce" : "SPZ")</td><td>@permit.SubjectText()</td></tr>
                <tr><td>Areály</td><td>@permit.SitesText()</td></tr>
                <tr><td>Platnost</td><td>@permit.ValidFrom.ToString("d. M. yyyy") – @(permit.ValidTo?.ToString("d. M. yyyy") ?? "bez omezení")</td></tr>
                @if (permit.PermitNumber is not null)
                {
                    <tr><td>Číslo povolení</td><td><a asp-page="/Parking/Permit" asp-route-id="@permit.Id">@permit.PermitNumber</a></td></tr>
                }
            </table>
        }

        @if (item.Decisions.Count > 0)
        {
            <table class="data">
                <thead><tr><th>Úroveň</th><th>Schvalovatel</th><th>Rozhodnutí</th><th>Komentář</th><th>Kdy</th></tr></thead>
                <tbody>
                @foreach (var decision in item.Decisions.OrderBy(d => d.DecidedAt))
                {
                    <tr>
                        <td>@decision.LevelOrder</td>
                        <td>
                            @(decision.ApproverUser?.DisplayName ?? decision.ApproverUser?.UserName)
                            @if (decision.OnBehalfOfUserId is not null)
                            {
                                <span class="badge">v zástupu</span>
                            }
                        </td>
                        <td>@(decision.Approved ? "✔ schváleno" : "✖ zamítnuto")</td>
                        <td class="muted">@decision.Comment</td>
                        <td class="muted">@decision.DecidedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @if (Model.CanDecide.Contains(item.Id))
        {
            <form method="post" style="margin-top:0.6rem">
                <input type="hidden" name="itemId" value="@item.Id" />
                <label>Komentář (u zamítnutí povinný)</label>
                <input type="text" name="comment" />
                <button class="btn" type="submit" asp-page-handler="Approve">Schválit</button>
                <button class="btn btn-danger" type="submit" asp-page-handler="Reject">Zamítnout</button>
            </form>
        }
    </div>
}

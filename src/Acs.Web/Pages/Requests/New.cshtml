@page
@model Acs.Web.Pages.Requests.NewModel
@{
    ViewData["Title"] = "Nová žádost o přístup";
}
<h1>Nová žádost o přístup</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="card" style="max-width:720px">
    <form method="post">
        @if (!Model.CanActForOthers)
        {
            @* Běžný uživatel žádá vždy sám za sebe — rovnou předvyplněno. *@
            @if (Model.MyEmployeeId is null)
            {
                <div class="alert alert-error">
                    Váš účet není spárován se zaměstnancem — žádost nelze podat.
                    Kontaktujte správce číselníků (párování probíhá podle AD účtu).
                </div>
            }
            else
            {
                <label>Pro zaměstnance</label>
                <p style="margin:0.2rem 0 0.6rem"><strong>@Model.MyEmployeeName</strong> <span class="muted">(vy)</span></p>
                <input type="hidden" name="targetEmployeeId" value="@Model.MyEmployeeId" />
            }
        }
        else
        {
            <label>Pro zaměstnance (pište pro hledání)</label>
            <input type="text" id="employee-search" placeholder="Hledat jméno, oddělení, osobní číslo…"
                   autocomplete="off" style="margin-bottom:0.3rem" />
            <select name="targetEmployeeId" id="employee-select" required size="1">
                <option value="">— vyberte —</option>
                @foreach (var employee in Model.Employees)
                {
                    <option value="@employee.Id" selected="@(employee.Id == Model.MyEmployeeId)"
                            data-search="@($"{employee.FullName} {employee.Department} {employee.PersonalNumber}")">
                        @employee.FullName @(employee.Department is null ? "" : $"({employee.Department})")
                    </option>
                }
            </select>
            <p class="hint" id="employee-hint">
                @if (Model.Employees.Count == 0)
                {
                    <text>Žádní zaměstnanci — nejdřív je importujte (Katalog → Zaměstnanci → Synchronizovat).</text>
                }
                else
                {
                    <text>@Model.Employees.Count zaměstnanců; hledá se bez ohledu na diakritiku a velikost písmen.</text>
                }
            </p>
        }

        @if (Model.Groups.Count > 0)
        {
            <label>Skupiny čteček (schvaluje se maticí skupiny a nadřazených skupin)</label>
            <div style="max-height:220px;overflow:auto;border:1px solid var(--border);border-radius:6px;padding:0.5rem">
                @foreach (var group in Model.Groups)
                {
                    <div class="checkbox-row" style="margin:0.25rem 0">
                        <input type="checkbox" name="groupIds" value="@group.Id" id="group-@group.Id" />
                        <label for="group-@group.Id">@group.Name <span class="muted">@group.Description</span></label>
                    </div>
                }
            </div>
        }

        <label>Čtečky (vyžadované čtečky z řetězce se doplní automaticky)</label>
        <input type="text" id="reader-search" placeholder="Hledat čtečku nebo umístění…"
               autocomplete="off" style="margin-bottom:0.3rem" />
        <div style="max-height:300px;overflow:auto;border:1px solid var(--border);border-radius:6px;padding:0.5rem" id="reader-list">
            @foreach (var reader in Model.Readers)
            {
                <div class="checkbox-row" style="margin:0.25rem 0">
                    <input type="checkbox" name="readerIds" value="@reader.Id" id="reader-@reader.Id" />
                    <label for="reader-@reader.Id">
                        @reader.Name
                        @if (reader.Room is not null || reader.Corridor is not null)
                        {
                            <span class="muted"> — @reader.LocationPath()</span>
                        }
                        @if (reader.Dependencies.Count > 0)
                        {
                            <span class="badge" title="Automaticky doplní: @string.Join(", ", reader.Dependencies.Select(d => d.RequiresReader?.Name))">
                                +@reader.Dependencies.Count v řetězci
                            </span>
                        }
                    </label>
                </div>
            }
        </div>

        <label>Zdůvodnění</label>
        <textarea name="justification" rows="3" placeholder="Proč je přístup potřeba…"></textarea>

        <button class="btn" type="submit" disabled="@(!Model.CanActForOthers && Model.MyEmployeeId is null)">Podat žádost</button>
        <a class="btn btn-ghost" asp-page="Index">Zpět</a>
    </form>
</div>

@section Scripts {
<script>
(() => {
    // Hledání bez diakritiky a velikosti písmen: „pavlicek“ najde „Pavlíček“.
    const fold = (text) => (text || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const matches = (haystack, term) => term.split(/\s+/).filter(Boolean).every(word => haystack.includes(word));

    // Textové hledání zaměstnance. Možnosti nativního výběru se neschovávají atributem
    // hidden (Safari ho u <option> ignoruje), ale výběr se za psaní znovu sestaví jen
    // z odpovídajících položek a první z nich se rovnou vybere.
    const search = document.getElementById('employee-search');
    const select = document.getElementById('employee-select');
    const hint = document.getElementById('employee-hint');
    if (search && select) {
        const all = [...select.querySelectorAll('option[data-search]')].map(option => ({
            value: option.value,
            label: option.textContent.trim(),
            search: fold(option.dataset.search),
            selected: option.selected,
        }));
        const placeholder = select.querySelector('option[value=""]');
        const hintText = hint ? hint.textContent : '';

        const rebuild = (term) => {
            const folded = fold(term.trim());
            const found = folded === '' ? all : all.filter(item => matches(item.search, folded));
            const current = select.value;
            select.innerHTML = '';
            if (placeholder && (folded === '' || found.length === 0)) select.appendChild(placeholder.cloneNode(true));
            for (const item of found.slice(0, 300)) {
                const option = document.createElement('option');
                option.value = item.value;
                option.textContent = item.label;
                select.appendChild(option);
            }
            // Zůstane vybraný ten, kdo hledání odpovídá; jinak první nalezený.
            if (found.some(item => item.value === current) && current !== '') select.value = current;
            else if (folded !== '' && found.length > 0) select.value = found[0].value;
            select.size = folded !== '' && found.length > 1 ? Math.min(found.length, 8) : 1;
            if (hint) {
                hint.textContent = folded === ''
                    ? hintText
                    : found.length === 0
                        ? `Nikdo neodpovídá „${term.trim()}“ — zkuste část jména, oddělení nebo osobní číslo.`
                        : `${found.length} odpovídá${found.length > 300 ? ' (zobrazeno 300)' : ''}.`;
            }
        };

        search.addEventListener('input', () => rebuild(search.value));
        // Enter v hledání nemá odeslat formulář, jen potvrdit první nalezený.
        search.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') { event.preventDefault(); select.focus(); }
        });
    }

    // Filtr čteček — skrývá řádky se zaškrtávátky podle textu (také bez diakritiky).
    const readerSearch = document.getElementById('reader-search');
    const readerList = document.getElementById('reader-list');
    if (readerSearch && readerList) {
        const rows = [...readerList.querySelectorAll('.checkbox-row')].map(row => ({ row, text: fold(row.textContent) }));
        readerSearch.addEventListener('input', () => {
            const term = fold(readerSearch.value.trim());
            for (const item of rows)
                item.row.style.display = term === '' || matches(item.text, term) ? '' : 'none';
        });
    }
})();
</script>
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NTLM klienta (integrační API karet přihlašované účtem domény) spravovanou implementací .NET.
      Bez toho .NET na Linuxu volá GSSAPI a bez balíku gssntlmssp (nebo s jeho starší verzí)
      NTLM selže. Serverové Negotiate (přihlášení uživatelů Kerberosem) tento přepínač neovlivní.
    -->
    <RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Přihlášení účtem Windows (Negotiate: Kerberos / NTLM) přímo v Kestrelu. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acs.Infrastructure\Acs.Infrastructure.csproj" />
  </ItemGroup>

</Project>

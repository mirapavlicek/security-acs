<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acs.WinPakConnector</RootNamespace>
    <!-- Aplikace se publikuje pro win-x64 (běží na WIN-PAK serveru jako Windows služba),
         ale vyvíjet a testovat ji lze na jakékoli platformě. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Testy ověřují i pomocnou logiku mapování na COM, která nepatří do veřejného API. -->
    <InternalsVisibleTo Include="Acs.WinPakConnector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aktualizační skript je součástí konektoru: samoaktualizace ho spouští z prostředků,
         ne z přijatého balíku, aby vždy odpovídal běžící verzi. -->
    <EmbeddedResource Include="..\..\deploy\Update-WinPakConnector.ps1" LogicalName="Update-WinPakConnector.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
  </ItemGroup>

</Project>

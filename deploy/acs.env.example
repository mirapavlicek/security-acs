# =============================================================================
# ACS – konfigurace prostředí (bootstrap). Vše ostatní se nastavuje v GUI.
# Zkopírujte jako deploy/acs.env (lokálně, NEcommitujte) — instalační skript
# ho nahraje na nody do /etc/acs/acs.env (chmod 600).
# =============================================================================

# MariaDB Galera — režim Failover dle zadání.
ConnectionStrings__Default=Server=10.84.12.170,10.84.12.171,10.84.12.172;Port=3306;Database=winpak;User=winpak;Password=CHANGE_ME;LoadBalance=Failover
Database__Provider=MariaDb

# Kestrel — port 52000 (před aplikací je HAProxy).
Kestrel__Endpoints__Http__Url=http://0.0.0.0:52000

ASPNETCORE_ENVIRONMENT=Production

# Auto-update:
#   ACS_UPDATE_MODE=tag    → nasazuje jen release tagy vX.Y.Z (výchozí, bezpečnější)
#   ACS_UPDATE_MODE=branch → nasazuje každý commit ve větvi (rychlé iterace, méně bezpečné)
ACS_UPDATE_MODE=tag
ACS_UPDATE_BRANCH=main
